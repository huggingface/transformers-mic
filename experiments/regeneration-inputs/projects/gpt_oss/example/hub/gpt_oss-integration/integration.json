{
  "mic": "0.3",
  "name": "GPT-OSS",
  "usage": "AutoTokenizer + AutoModelForCausalLM, greedy forward pass with two prompts and one SGD training step with causal-LM labels",
  "architecture": "GptOssForCausalLM",
  "checkpoints": {
    "openai/gpt-oss-20b": {
      "fixture": "hf-internal-testing/mic-gpt_oss-slim"
    }
  },
  "fixtures": {
    "hf-internal-testing/mic-gpt_oss-slim": {
      "built_from": "openai/gpt-oss-20b",
      "covers": [
        "openai/gpt-oss-20b"
      ],
      "why_separate": "Full 20B MoE model with mxfp4 quantization is impractical for cross-platform testing; the slim fixture removes quantization and reduces layer count to exercise the base architecture in standard precision.",
      "build": {
        "seed": 17,
        "model_class": "GptOssForCausalLM",
        "config_overrides": {
          "fields": {
            "quantization_config": null,
            "num_hidden_layers": 2,
            "num_local_experts": 4,
            "num_experts_per_tok": 2
          },
          "reason": "Remove mxfp4 quantization so the fixture exercises the base architecture in standard precision; reduce layers and experts to keep the fixture small enough for CPU testing"
        }
      }
    }
  },
  "integrations": {
    "transformers": {
      "entry_point": "integrations/transformers/usage.md",
      "format": "runnable-markdown",
      "requires": [
        "transformers>=4.55",
        "torch"
      ],
      "targets": [
        "fixtures"
      ],
      "variants": {
        "default": {},
        "eager": {
          "attn_implementation": "eager"
        },
        "bfloat16": {
          "dtype": "bfloat16"
        }
      },
      "training": true,
      "resources": {
        "fixture": {
          "memory_gb": 4,
          "download_mb": 500,
          "devices": [
            "cpu",
            "cuda"
          ]
        },
        "openai/gpt-oss-20b": {
          "memory_gb": 80,
          "download_mb": 40000,
          "devices": [
            "cuda"
          ],
          "gpus": 1,
          "gpu_memory_gb": 48
        }
      }
    }
  },
  "outputs": {
    "runtime": {
      "compare": "exact"
    },
    "predicted_tokens": {
      "compare": "exact"
    },
    "answer_logits": {
      "compare": "allclose",
      "atol": 0.0001,
      "rtol": 0.0001
    },
    "training.loss": {
      "compare": "allclose",
      "atol": 0.0001,
      "rtol": 0.0001
    },
    "training.gradients": {
      "compare": "all_true"
    },
    "training.updated": {
      "compare": "true"
    }
  }
}
