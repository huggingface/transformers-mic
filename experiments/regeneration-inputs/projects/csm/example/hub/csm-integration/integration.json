{
  "mic": "0.3",
  "name": "CSM Voice: text-to-audio",
  "usage": "AutoModelForCausalLM + AutoTokenizer, text-to-audio logits, batched with padding",
  "architecture": "CsmForConditionalGeneration",
  "checkpoints": {
    "cartesia/azzurra-voice": {
      "fixture": "hf-internal-testing/mic-csm-slim"
    }
  },
  "fixtures": {
    "hf-internal-testing/mic-csm-slim": {
      "built_from": "cartesia/azzurra-voice",
      "covers": [
        "cartesia/azzurra-voice"
      ],
      "build": {
        "seed": 17
      }
    }
  },
  "integrations": {
    "transformers": {
      "entry_point": "integrations/transformers/usage.md",
      "format": "runnable-markdown",
      "requires": [
        "transformers>=5",
        "torch"
      ],
      "targets": [
        "fixtures"
      ],
      "variants": {
        "default": {},
        "eager": {
          "attn_implementation": "eager"
        },
        "bfloat16": {
          "dtype": "bfloat16"
        }
      },
      "training": true,
      "resources": {
        "fixture": {
          "memory_gb": 2,
          "download_mb": 500
        },
        "cartesia/azzurra-voice": {
          "memory_gb": 8,
          "download_mb": 4500,
          "variants": {
            "bfloat16": {
              "memory_gb": 4
            }
          }
        }
      }
    }
  },
  "outputs": {
    "runtime": {
      "compare": "exact"
    },
    "audio_logits": {
      "compare": "allclose",
      "atol": 0.0001,
      "rtol": 0.0001
    },
    "training.loss": {
      "compare": "allclose",
      "atol": 0.0001,
      "rtol": 0.0001
    },
    "training.gradients": {
      "compare": "all_true"
    },
    "training.updated": {
      "compare": "true"
    }
  }
}
