{
  "mic": "0.3",
  "name": "Qwen2-Audio",
  "usage": "AutoProcessor + AutoModelForCausalLM, synthetic audio, batched, right padding",
  "architecture": "Qwen2AudioForConditionalGeneration",
  "checkpoints": {
    "Qwen/Qwen2-Audio-7B": {
      "fixture": "hf-internal-testing/mic-qwen2_audio-slim"
    }
  },
  "fixtures": {
    "hf-internal-testing/mic-qwen2_audio-slim": {
      "built_from": "Qwen/Qwen2-Audio-7B",
      "covers": [
        "Qwen/Qwen2-Audio-7B"
      ],
      "build": {
        "seed": 17
      }
    }
  },
  "integrations": {
    "transformers": {
      "entry_point": "integrations/transformers/usage.md",
      "format": "runnable-markdown",
      "requires": [
        "transformers>=4.46",
        "torch"
      ],
      "targets": [
        "fixtures"
      ],
      "variants": {
        "default": {},
        "eager": {
          "attn_implementation": "eager"
        },
        "bfloat16": {
          "dtype": "bfloat16"
        }
      },
      "training": true,
      "resources": {
        "fixture": {
          "memory_gb": 4,
          "download_mb": 500
        },
        "Qwen/Qwen2-Audio-7B": {
          "memory_gb": 32,
          "download_mb": 15000,
          "gpu_memory_gb": 16,
          "variants": {
            "bfloat16": {
              "memory_gb": 16,
              "gpu_memory_gb": 16
            }
          }
        }
      }
    }
  },
  "outputs": {
    "runtime": {
      "compare": "exact"
    },
    "selected_logits": {
      "compare": "allclose",
      "atol": 0.0001,
      "rtol": 0.0001
    },
    "training.loss": {
      "compare": "allclose",
      "atol": 0.0001,
      "rtol": 0.0001
    },
    "training.gradients": {
      "compare": "all_true"
    },
    "training.updated": {
      "compare": "true"
    }
  }
}
