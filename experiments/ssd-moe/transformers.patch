+class ExpertPoolTest(unittest.TestCase):
+    """Cached experts run through Transformers' grouped_mm / batched_mm kernels on a shared slot pool."""
+
+    def make_checkpoint(self, directory):
+        torch.manual_seed(5)
+        config = Qwen3MoeConfig(
+            vocab_size=64,
+            hidden_size=16,
+            intermediate_size=24,
+            moe_intermediate_size=8,
+            num_hidden_layers=2,
+            num_attention_heads=2,
+            num_key_value_heads=1,
+            head_dim=8,
+            num_experts=4,
+            num_experts_per_tok=2,
+        )
+        config._experts_implementation = "eager"
+        config._attn_implementation = "eager"
+        reference = Qwen3MoeForCausalLM(config).eval()
+        path = Path(directory)
+        config.save_pretrained(path)
+        save_file(reference.state_dict(), path / "model.safetensors")
+        return reference, path
+
+    def test_kernels_match_eager_for_every_cache_size(self):
+        expert_bytes = 3 * 8 * 16 * 4
+        ids = torch.tensor([[1, 7, 3, 9, 2, 11, 5]])
+        with tempfile.TemporaryDirectory() as directory:
+            reference, path = self.make_checkpoint(directory)
+            with torch.no_grad():
+                expected = reference.generate(ids, max_new_tokens=6, do_sample=False, pad_token_id=0)
+            # 1 slot: smaller than one call's working set, so most experts run uncached next to the pool.
+            # 8 slots: every expert of the model; decoding then never synchronizes with the host.
+            for implementation in ("grouped_mm", "batched_mm"):
+                for slots in (1, 3, 8):
+                    with self.subTest(implementation=implementation, slots=slots):
+                        streamed = load_moe_from_ssd(
+                            path, cache_bytes=slots * expert_bytes, experts_implementation=implementation
+                        )
+                        self.assertEqual(streamed.ssd_store.num_slots, slots)
+                        with torch.no_grad():
+                            actual = streamed.generate(ids, max_new_tokens=6, do_sample=False, pad_token_id=0)
+                        torch.testing.assert_close(actual, expected)
+                        self.assertLessEqual(streamed.ssd_store.resident_bytes, slots * expert_bytes)
+                        self.assertEqual(streamed.ssd_store.all_resident(), slots == 8)
+
+    def test_fully_resident_layers_skip_the_host_copy(self):
+        with tempfile.TemporaryDirectory() as directory:
+            _, path = self.make_checkpoint(directory)
+            streamed = load_moe_from_ssd(path, cache_bytes=8 * 3 * 8 * 16 * 4)
+            store = streamed.ssd_store
+            for prefix in store.slot_tables:
+                for expert in range(4):
+                    store.acquire(prefix, expert)
+            self.assertTrue(store.all_resident())
+            original = torch.Tensor.cpu
+            with mock.patch.object(torch.Tensor, "cpu", autospec=True, side_effect=original) as cpu:
+                with torch.no_grad():
+                    streamed(torch.tensor([[3, 4]]))
+            self.assertFalse(any(call.args[0].dtype == torch.long for call in cpu.call_args_list))
+
+    def test_parallel_reads_and_next_layer_prefetch_match_eager(self):
+        expert_bytes = 3 * 8 * 16 * 4
+        ids = torch.tensor([[1, 7, 3, 9, 2, 11, 5]])
+        with tempfile.TemporaryDirectory() as directory:
+            reference, path = self.make_checkpoint(directory)
+            with torch.no_grad():
+                expected = reference.generate(ids, max_new_tokens=8, do_sample=False, pad_token_id=0)
+            for io_threads in (0, 1, 4):
+                with self.subTest(io_threads=io_threads):
+                    streamed = load_moe_from_ssd(path, cache_bytes=3 * expert_bytes, io_threads=io_threads)
+                    layers = streamed.model.layers
+                    self.assertIs(layers[0].mlp.experts.ssd_next[1], layers[1].mlp.gate)
+                    self.assertIsNone(layers[1].mlp.experts.ssd_next)
+                    with torch.no_grad():
+                        actual = streamed.generate(ids, max_new_tokens=8, do_sample=False, pad_token_id=0)
+                    torch.testing.assert_close(actual, expected)
+                    store = streamed.ssd_store
+                    self.assertEqual(store.pending, {})
+                    if io_threads:
+                        self.assertGreater(store.prefetch_used, 0)
+                        self.assertLessEqual(store.prefetch_used, store.prefetched)
+                    else:
+                        self.assertEqual(store.prefetched, 0)
