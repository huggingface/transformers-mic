+    def test_prefill_and_cached_decode_match_for_both_checkpoint_layouts(self):
+        ids = torch.tensor([[1, 2, 3, 4, 5], [5, 4, 3, 2, 1]])
+        for unpacked in (False, True):
+            with self.subTest(unpacked=unpacked):
+                self.save_checkpoint(unpacked=unpacked, sharded=True)
+                streamed = load_qwen3_moe_from_ssd(self.path, cache_bytes=self.expert_bytes, token_chunk_size=2)
+                self.assertFalse(any(".experts." in name for name, _ in streamed.named_parameters()))
+                with torch.inference_mode():
+                    expected = self.reference(ids, use_cache=True)
+                    actual = streamed(ids, use_cache=True)
+                    torch.testing.assert_close(actual.logits, expected.logits, atol=1e-6, rtol=1e-5)
+                    for _ in range(3):
+                        next_id = expected.logits[:, -1].argmax(-1, keepdim=True)
+                        expected = self.reference(next_id, past_key_values=expected.past_key_values, use_cache=True)
+                        actual = streamed(next_id, past_key_values=actual.past_key_values, use_cache=True)
+                        torch.testing.assert_close(actual.logits, expected.logits, atol=1e-6, rtol=1e-5)
+                self.assertGreater(streamed.ssd_store.evictions, 0)
+                self.assertLessEqual(streamed.ssd_store.peak_cache_bytes, self.expert_bytes)
+
+    def test_sparse_reads_cache_hits_eviction_and_zero_budget(self):
+        self.save_checkpoint()
+        for budget in (0, self.expert_bytes):
+            with self.subTest(budget=budget):
+                model = load_qwen3_moe_from_ssd(self.path, cache_bytes=budget)
+                module = model.model.layers[0].mlp.experts
+                eager = self.reference.model.layers[0].mlp.experts
+                hidden = torch.randn(2, 16)
+                weights = torch.ones(2, 1)
+                ids = torch.zeros(2, 1, dtype=torch.long)
+                with torch.inference_mode():
+                    torch.testing.assert_close(module(hidden, ids, weights), eager(hidden, ids, weights))
+                    self.assertEqual(model.ssd_store.reader.read_bytes, self.expert_bytes)
+                    module(hidden, ids, weights)
+                    self.assertEqual(model.ssd_store.hits, int(budget > 0))
+                    module(hidden, ids + 1, weights)
+                    torch.testing.assert_close(module(hidden, ids, weights), eager(hidden, ids, weights))
+                self.assertLessEqual(model.ssd_store.resident_bytes, budget)
+                self.assertEqual(model.ssd_store.misses, 3 if budget else 4)
+
+    def test_generation_and_inference_guard(self):
+        self.save_checkpoint()
+        model = load_qwen3_moe_from_ssd(self.path)
+        ids = torch.tensor([[1, 3, 5]])
+        with torch.inference_mode():
+            expected = self.reference.generate(ids, max_new_tokens=3, do_sample=False, pad_token_id=0)
+            actual = model.generate(ids, max_new_tokens=3, do_sample=False, pad_token_id=0)
+        torch.testing.assert_close(actual, expected)
+        with self.assertRaisesRegex(RuntimeError, "requires eval"):
+            model(ids)
+
+    def test_missing_expert_fails_during_loading(self):
+        self.save_checkpoint(unpacked=True)
+        weights = load_file(self.path / "model.safetensors")
+        del weights["model.layers.0.mlp.experts.0.gate_proj.weight"]
+        save_file(weights, self.path / "model.safetensors")
+        with self.assertRaisesRegex(ValueError, "Missing or incompatible expert"):
+            load_qwen3_moe_from_ssd(self.path)
+
+    def test_reduced_precision_and_chunked_prefill(self):
+        ids = torch.tensor([[1, 2, 3, 4, 5]])
+        self.save_checkpoint()
+        for dtype in (torch.float16, torch.bfloat16):
+            with self.subTest(dtype=dtype):
+                eager = Qwen3MoeForCausalLM.from_pretrained(
+                    self.path, dtype=dtype, experts_implementation="eager", attn_implementation="eager"
+                ).eval()
+                model = load_qwen3_moe_from_ssd(self.path, dtype=dtype, cache_bytes=self.expert_bytes // 2)
+                with torch.inference_mode():
+                    expected = eager(ids).logits[:, -1]
+                    past = None
+                    for chunk in ids.split(2, dim=1):
+                        actual = model(chunk, past_key_values=past, use_cache=True)
+                        past = actual.past_key_values
+                    torch.testing.assert_close(actual.logits[:, -1], expected)
+
+    def test_tied_embeddings(self):
+        self.config.tie_word_embeddings = True
+        eager = Qwen3MoeForCausalLM(self.config).eval()
+        eager.save_pretrained(self.path)
+        model = load_qwen3_moe_from_ssd(self.path)
+        self.assertIs(model.lm_head.weight, model.model.embed_tokens.weight)
+        with torch.inference_mode():
+            ids = torch.tensor([[1, 2, 3]])
+            torch.testing.assert_close(model(ids).logits, eager(ids).logits)
+
+    def test_truncated_checkpoint_read_raises(self):
+        self.save_checkpoint()
+        model = load_qwen3_moe_from_ssd(self.path)
+        with (self.path / "model.safetensors").open("r+b") as handle:
+            handle.truncate(0)
+        with torch.inference_mode(), self.assertRaisesRegex(OSError, "Short checkpoint read"):
+            model(torch.tensor([[1, 2, 3]]))
