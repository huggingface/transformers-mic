+# Reads run on I/O threads (os reads release the GIL); their byte counters are shared.
+_COUNTER_LOCK = threading.Lock()
+
+
+def _read_exact(path, offset, size, bypass_page_cache, what):
+    """Read ``size`` bytes at ``offset``. With ``bypass_page_cache``, the bytes do not stay in the OS page cache
+    (macOS: F_NOCACHE; elsewhere: drop the range after reading), so every miss is a real storage read."""
+    data = bytearray(size)
+    with path.open("rb", buffering=0) as handle:
+        if bypass_page_cache and hasattr(fcntl, "F_NOCACHE"):
+            fcntl.fcntl(handle.fileno(), fcntl.F_NOCACHE, 1)
+        handle.seek(offset)
+        view = memoryview(data)
+        done = 0
+        while done < size:
+            count = handle.readinto(view[done:])
+            if not count:
+                raise OSError(f"Short checkpoint read: {path}, {what}")
+            done += count
+        if bypass_page_cache and hasattr(os, "posix_fadvise"):
+            os.posix_fadvise(handle.fileno(), offset, size, os.POSIX_FADV_DONTNEED)
+    return data
+
+
+class SafetensorsReader:
+    """Index validated safetensors headers, then read whole tensors or contiguous expert slices.
+
+    File handles are scoped to individual reads. No whole-file mapping survives indexing and no full
+    packed expert tensor is loaded. Both sharded and single-file local checkpoints are supported.
+    """
+
+    def __init__(self, directory, bypass_page_cache=False, packed=False):
+        directory = Path(directory)
+        self.bypass_page_cache = bypass_page_cache
+        self.dtypes = _PACKED_DTYPES if packed else _DTYPES
+        index = directory / "model.safetensors.index.json"
+        if index.exists():
+            weight_map = json.loads(index.read_text())["weight_map"]
+            filenames = sorted(set(weight_map.values()))
+        else:
+            weight_map = None
+            filenames = ["model.safetensors"]
+        self.tensors = {}
+        self.read_bytes = 0
+        self.read_calls = 0
+        for filename in filenames:
+            path = (directory / filename).resolve()
+            if not path.is_file():
+                raise FileNotFoundError(f"Missing checkpoint shard: {path}")
+            # Delegate safetensors format validation (offsets, sizes, overlaps) to safetensors.
+            with safe_open(path, framework="pt", device="cpu") as handle:
+                keys = set(handle.keys())
+            with path.open("rb") as handle:
+                header_size = int.from_bytes(handle.read(8), "little")
+                header = json.loads(handle.read(header_size))
+            for name in keys:
+                info = header[name]
+                if name in self.tensors:
+                    raise ValueError(f"Duplicate checkpoint tensor: {name}")
+                if info["dtype"] not in self.dtypes:
+                    raise ValueError(f"Only unquantized F32/F16/BF16 checkpoints are supported: {name}")
+                self.tensors[name] = (path, 8 + header_size + info["data_offsets"][0], info)
+                if weight_map is not None and weight_map.get(name) != filename:
+                    raise ValueError(f"Checkpoint index disagrees with shard for {name}")
+        if weight_map is not None and set(weight_map) != set(self.tensors):
+            raise ValueError("Checkpoint index contains missing tensors")
+
+    def shape(self, name):
+        return tuple(self.tensors[name][2]["shape"])
+
+    def read(self, name, expert=None):
+        path, offset, info = self.tensors[name]
+        shape = tuple(info["shape"])
+        dtype = self.dtypes[info["dtype"]]
+        item_size = torch.empty((), dtype=dtype).element_size()
+        if expert is not None:
+            if len(shape) < 2 or not 0 <= expert < shape[0]:
+                raise ValueError(f"Invalid expert slice {expert} for {name}: {shape}")
+            shape = shape[1:]
+            offset += expert * math.prod(shape) * item_size
+        size = math.prod(shape) * item_size
+        data = _read_exact(path, offset, size, self.bypass_page_cache, f"tensor {name}")
+        with _COUNTER_LOCK:
+            self.read_bytes += size
+            self.read_calls += 1
+        return torch.frombuffer(data, dtype=dtype).reshape(shape)
+
+
+# GGUF metadata value types -> struct formats (8 = string and 9 = array are handled separately).
+_GGUF_SCALARS = {0: "<B", 1: "<b", 2: "<H", 3: "<h", 4: "<I", 5: "<i", 6: "<f", 7: "<?", 10: "<Q", 11: "<q", 12: "<d"}
+# ggml tensor types this reader understands -> (elements per block, bytes per block).
+_GGML_F32, _GGML_F16, _GGML_Q8_0, _GGML_BF16 = 0, 1, 8, 30
+_GGML_BLOCKS = {_GGML_F32: (1, 4), _GGML_F16: (1, 2), _GGML_Q8_0: (32, 34), _GGML_BF16: (1, 2)}
+_GGUF_PROJECTIONS = {"gate": "ffn_gate_exps", "up": "ffn_up_exps", "down": "ffn_down_exps"}
+
+
+def _read_gguf_index(handle):
+    """Parse a GGUF (v2/v3) header: {tensor name: (ggml dims, ggml type, absolute offset)}. Reads no tensor data."""
+
+    def read(fmt):
+        return struct.unpack(fmt, handle.read(struct.calcsize(fmt)))[0]
+
+    def string():
+        return handle.read(read("<Q")).decode("utf-8")
+
+    def value(kind):
+        if kind == 8:
+            return string()
+        if kind == 9:
+            item, count = read("<I"), read("<Q")
+            return [value(item) for _ in range(count)]
+        if kind not in _GGUF_SCALARS:
+            raise ValueError(f"Unknown GGUF metadata type {kind}")
+        return read(_GGUF_SCALARS[kind])
+
+    if handle.read(4) != b"GGUF":
+        raise ValueError("Not a GGUF file")
+    version, n_tensors, n_metadata = read("<I"), read("<Q"), read("<Q")
+    if version not in (2, 3):
+        raise ValueError(f"Unsupported GGUF version {version}")
+    metadata = {}
+    for _ in range(n_metadata):
+        key = string()
+        metadata[key] = value(read("<I"))
+    infos = []
+    for _ in range(n_tensors):
+        name = string()
+        dims = [read("<Q") for _ in range(read("<I"))]
+        infos.append((name, dims, read("<I"), read("<Q")))
+    alignment = metadata.get("general.alignment", 32)
+    start = handle.tell()
+    start += -start % alignment
+    return {name: (dims, kind, start + offset) for name, dims, kind, offset in infos}
+
+
+class GGUFExpertReader:
+    """Read single experts of llama.cpp ``blk.N.ffn_{gate,up,down}_exps`` tensors, as raw bytes.
+
+    ggml stores such a tensor with dims ``[columns, rows, experts]`` (innermost first), so one expert is one contiguous
+    ``rows x columns`` matrix in the PyTorch ``(out_features, in_features)`` orientation. Q8_0 rows are blocks of one
+    float16 scale and 32 int8 values; they stay quantized until :func:`dequantize_gguf` runs on the execution device.
+    """
+
+    def __init__(self, path, bypass_page_cache=False):
+        self.path = Path(path).resolve()
+        self.bypass_page_cache = bypass_page_cache
+        with self.path.open("rb") as handle:
+            self.tensors = _read_gguf_index(handle)
+        self.read_bytes = 0
+        self.read_calls = 0
+
+    def layout(self, layer, projection):
+        name = f"blk.{layer}.{_GGUF_PROJECTIONS[projection]}.weight"
+        if name not in self.tensors:
+            raise ValueError(f"Missing GGUF expert tensor {name}")
+        dims, kind, offset = self.tensors[name]
+        if kind not in _GGML_BLOCKS or len(dims) != 3:
+            raise ValueError(f"Unsupported GGUF expert tensor {name}: ggml type {kind}, dims {dims}")
+        columns, rows, experts = dims
+        block_elements, block_bytes = _GGML_BLOCKS[kind]
+        if columns % block_elements:
+            raise ValueError(f"GGUF row of {name} is not a whole number of blocks")
+        expert_bytes = rows * columns // block_elements * block_bytes
+        return kind, rows, columns, experts, offset, expert_bytes
+
+    def read(self, layer, projection, expert):
+        kind, rows, columns, experts, offset, size = self.layout(layer, projection)
+        if not 0 <= expert < experts:
+            raise ValueError(f"Invalid expert {expert} for layer {layer}")
+        data = _read_exact(
+            self.path, offset + expert * size, size, self.bypass_page_cache, f"layer {layer} {projection}"
+        )
+        with _COUNTER_LOCK:
+            self.read_bytes += size
+            self.read_calls += 1
+        return torch.frombuffer(data, dtype=torch.uint8)
+
+
+def dequantize_gguf(raw, kind, rows, columns, dtype):
+    """Raw bytes of one ggml matrix (on any device) -> a ``(rows, columns)`` tensor of ``dtype`` on that device."""
+    if kind == _GGML_Q8_0:
+        blocks = raw.view(rows, columns // 32, 34)
+        scales = blocks[..., :2].contiguous().view(torch.float16).float()
+        values = blocks[..., 2:].contiguous().view(torch.int8).float()
+        return (values * scales).to(dtype).reshape(rows, columns)
+    source = {_GGML_F32: torch.float32, _GGML_F16: torch.float16, _GGML_BF16: torch.bfloat16}[kind]
+    return raw.view(source).reshape(rows, columns).to(dtype)
+
+
+class ExpertStore:
+    """One global expert cache across layers, budgeted in bytes of what it keeps on the execution device: the execution
+    dtype, or the GGUF's own bytes (e.g. Q8_0) when the experts come from a GGUF, dequantized on each use.
+
+    Policies:
+    - ``"lru"``: evict the least recently used expert. Decoding visits every layer in order, so when the experts used by
+      one token do not all fit, LRU evicts exactly the expert the next token needs first and the hit rate drops to 0.
+    - ``"lfu"``: keep a usage count per expert, halved every ``decay_every`` lookups so the set can follow the text.
+      When the cache is full, the least used resident expert is the victim, and a missing expert is admitted only when
+      it has been used more than that victim; otherwise it runs once without being cached. The cache settles on the
+      most used experts instead of cycling through all of them.
+
+    A miss evicts before loading. One active expert plus conversion/staging memory may exceed the cache
+    budget. Eviction never overwrites a tensor used by queued work; PyTorch owns tensor lifetimes.
+    The store is synchronous and intended for one inference request at a time.
+    """
+
+    def __init__(
+        self,
+        reader,
+        cache_bytes,
+        device,
+        dtype,
+        gguf=None,
+        policy="lru",
+        decay_every=4096,
+        io_threads=0,
+        quantized=None,
+    ):
+        if cache_bytes < 0:
+            raise ValueError("cache_bytes must be nonnegative")
+        if policy not in ("lru", "lfu"):
+            raise ValueError(f"Unknown cache policy {policy!r}; use 'lru' or 'lfu'")
+        self.policy = policy
+        self.decay_every = decay_every
+        self.counts = {}
+        self.heap = []  # (count, sequence, key) for resident experts; stale entries are skipped lazily
+        self.sequence = 0
+        self.lookups = 0
+        self.not_admitted = 0
+        self.reader = reader
+        self.gguf = gguf
+        self.cache_bytes = cache_bytes
+        self.device = torch.device(device)
+        self.dtype = dtype
+        self.cache = OrderedDict()
+        self.resident_bytes = 0
+        self.peak_cache_bytes = 0
+        self.hits = self.misses = self.evictions = 0
+        self.layouts = {}
+        # Unquantized experts live in one preallocated device pool of `cache_bytes // expert_bytes` slots, so a
+        # layer's resident experts are slices of a single bank that Transformers' grouped_mm / batched_mm kernels
+        # can index directly. Each layer keeps a device table expert -> slot (`num_slots` when not resident).
+        self.gate_up_pool = self.down_pool = None
+        self.pools = None
+        # Quantized experts: (reader of the `quantize_experts` directory, bits, group_size), run by `gather_qmm`.
+        self.quantized = None
+        if quantized is not None:
+            info = json.loads((Path(quantized) / "quantization.json").read_text())
+            if info.get("format") != _QUANTIZED_FORMAT:
+                raise ValueError(f"Unsupported quantized experts format {info.get('format')!r}")
+            self.quantized = (
+                SafetensorsReader(quantized, reader.bypass_page_cache, packed=True),
+                info["bits"],
+                info["group_size"],
+            )
+            self.gather_qmm = _load_gather_qmm(self.device)
+        self.num_slots = 0
+        self.free_slots = []
+        self.slot_tables = {}
+        self.total_experts = 0
+        self.compute = "grouped_mm"
+        # Reads of experts that are not resident run on `io_threads` threads: a layer's misses in parallel, and the
+        # predicted experts of the next layer in the background. They land in host memory and only enter the cache
+        # when a forward call actually uses them, so a wrong prediction costs storage bandwidth, never a cached expert.
+        self.executor = ThreadPoolExecutor(io_threads, thread_name_prefix="ssd-moe-io") if io_threads else None
+        self.pending = {}
+        self.window = 2 * io_threads
+        self.prefetched = self.prefetch_used = self.installed_ahead = 0
+        # Host buffers of non-blocking host-to-device copies still queued on the device; the next host
+        # synchronization (each layer's routing copy) proves they are done, see `release_host_buffers`.
+        self.inflight = []
+
+    def register(self, prefix, module):
+        shapes = {
+            "gate_up_proj": (module.num_experts, 2 * module.intermediate_dim, module.hidden_dim),
+            "down_proj": (module.num_experts, module.hidden_dim, module.intermediate_dim),
+        }
+        if f"{prefix}.gate_up_proj" in self.reader.tensors:
+            names = {f"{prefix}.{suffix}": shape for suffix, shape in shapes.items()}
+            packed = True
+        else:
+            names = {}
+            for expert in range(module.num_experts):
+                for projection in ("gate_proj", "up_proj", "down_proj"):
+                    shape = (module.intermediate_dim, module.hidden_dim)
+                    if projection == "down_proj":
+                        shape = shape[::-1]
+                    names[f"{prefix}.{expert}.{projection}.weight"] = shape
+            packed = False
+        for name, shape in names.items():
+            if name not in self.reader.tensors or self.reader.shape(name) != shape:
+                raise ValueError(f"Missing or incompatible expert tensor {name}; expected {shape}")
+        self.layouts[prefix] = (packed, 3 * module.intermediate_dim * module.hidden_dim)
+        if self.gguf is not None:
+            match = re.search(r"\.layers\.(\d+)\.", f".{prefix}.")
+            if match is None:
+                raise ValueError(f"Cannot find the layer index of {prefix}")
+            layer = int(match.group(1))
+            expected = {
+                "gate": (module.intermediate_dim, module.hidden_dim),
+                "up": (module.intermediate_dim, module.hidden_dim),
+                "down": (module.hidden_dim, module.intermediate_dim),
+            }
+            layouts = {}
+            for projection, shape in expected.items():
+                kind, rows, columns, experts, _, size = self.gguf.layout(layer, projection)
+                if (rows, columns) != shape or experts != module.num_experts:
+                    raise ValueError(
+                        f"GGUF layer {layer} {projection} is {experts}x{rows}x{columns}; expected {shape}"
+                    )
+                layouts[projection] = (kind, rows, columns, size)
+            # The safetensors expert banks are deliberately not read: they count as consumed.
+            self.layouts[prefix] = ("gguf", layer, layouts)
+        else:
+            if self.quantized is not None:
+                self._check_quantized(prefix, module)
+                self.layouts[prefix] = ("quantized",)
+            self._register_slots(prefix, module)
+        return set(names)
+
+    def _quantized_shapes(self, module):
+        """Per-expert shapes and dtypes of the quantized tensors, in pool order."""
+        _, bits, group_size = self.quantized
+        shapes = []
+        for rows, columns in (
+            (2 * module.intermediate_dim, module.hidden_dim),
+            (module.hidden_dim, module.intermediate_dim),
+        ):
+            if columns % group_size or (columns * bits) % 32:
+                raise ValueError(f"Input size {columns} does not fit {bits}-bit groups of {group_size}")
+            shapes += [
+                ((rows, columns * bits // 32), torch.uint32),
+                ((rows, columns // group_size), self.dtype),
+                ((rows, columns // group_size), self.dtype),
+            ]
+        return shapes
+
+    def _check_quantized(self, prefix, module):
+        reader, name = self.quantized[0], f"{prefix}.experts"
+        size = sum(math.prod(shape) * dtype.itemsize for shape, dtype in self._quantized_shapes(module))
+        if name not in reader.tensors or reader.shape(name) != (module.num_experts, size):
+            raise ValueError(
+                f"Missing or incompatible quantized experts {name}; expected {module.num_experts} x {size} bytes "
+                "(quantized from a checkpoint in the execution dtype)"
+            )
+
+    def _register_slots(self, prefix, module):
+        if self.quantized is not None:
+            shapes = self._quantized_shapes(module)
+        else:
+            shapes = [
+                ((2 * module.intermediate_dim, module.hidden_dim), self.dtype),
+                ((module.hidden_dim, module.intermediate_dim), self.dtype),
+            ]
+        if self.pools is None:
+            self._pool_shapes = shapes
+            self.slot_bytes = sum(math.prod(shape) * dtype.itemsize for shape, dtype in shapes)
+            self.num_slots = self.cache_bytes // self.slot_bytes
+            if self.quantized is not None:
+                # One byte buffer per slot holding the expert exactly as stored: a miss is one read and one copy.
+                # The kernel reads the six tensors through strided views of it.
+                self.slot_buffer = torch.empty(
+                    (self.num_slots, self.slot_bytes), device=self.device, dtype=torch.uint8
+                )
+                self.pools = list(_split_expert(self.slot_buffer, shapes))
+            else:
+                self.pools = [
+                    torch.empty((self.num_slots, *shape), device=self.device, dtype=dtype) for shape, dtype in shapes
+                ]
+            if self.quantized is None:
+                self.gate_up_pool, self.down_pool = self.pools
+            self.free_slots = list(range(self.num_slots - 1, -1, -1))
+        elif [tuple(pool.shape[1:]) for pool in self.pools] != [shape for shape, _ in shapes]:
+            raise ValueError("All MoE layers must have the same expert shapes to share the expert pool")
+        self.slot_tables[prefix] = torch.full((module.num_experts,), self.num_slots, device=self.device)
+        self.total_experts += module.num_experts
+
+    @property
+    def pooled(self):
+        return self.pools is not None
+
+    def all_resident(self):
+        """True when every expert of the model is cached: nothing can be evicted, no routing needs to reach the host."""
+        return self.pooled and len(self.cache) == self.total_experts
+
+    def _count(self, key):
+        self.lookups += 1
+        if self.policy != "lfu":
+            return
+        if self.decay_every and self.lookups % self.decay_every == 0:
+            self.counts = {k: v / 2 for k, v in self.counts.items() if v >= 0.25}
+            self.heap = []
+            for resident in self.cache:
+                self._push(resident)
+        self.counts[key] = self.counts.get(key, 0) + 1
+        if key in self.cache:
+            self._push(key)
+
+    def _push(self, key):
+        self.sequence += 1
+        heapq.heappush(self.heap, (self.counts.get(key, 0), self.sequence, key))
+
+    def _least_used(self):
+        while self.heap:
+            count, _, key = self.heap[0]
+            if key in self.cache and count == self.counts.get(key, 0):
+                return key, count
+            heapq.heappop(self.heap)
+        return None, None
+
+    def _evict(self, victim):
+        entry = self.cache.pop(victim)
+        self.resident_bytes -= entry[-1]
+        self.evictions += 1
+        if self.pooled:
+            self.free_slots.append(entry[0])
+            self.slot_tables[victim[0]][victim[1]] = self.num_slots
+
+    def _make_room(self, key, size, pinned=()):
+        """Evict until ``size`` fits; returns False when the policy declines to cache ``key``.
+
+        ``pinned`` experts are used by the forward call in progress and are never evicted for it.
+        """
+        if size > self.cache_bytes:
+            return False
+        if self.policy == "lfu":
+            while self.cache and self.resident_bytes + size > self.cache_bytes:
+                victim, count = self._least_used()
+                if victim is None or victim in pinned or self.counts.get(key, 0) <= count:
+                    self.not_admitted += 1
+                    return False
+                heapq.heappop(self.heap)
+                self._evict(victim)
+            return True
+        while self.cache and self.resident_bytes + size > self.cache_bytes:
+            victim = next((k for k in self.cache if k not in pinned), None)
+            if victim is None:
+                self.not_admitted += 1
+                return False
+            self._evict(victim)
+        return True
+
+    def _expert_bytes(self, prefix):
+        layout = self.layouts[prefix]
+        if layout[0] == "quantized":
+            return self.slot_bytes
+        if layout[0] == "gguf":
+            return sum(entry[3] for entry in layout[2].values())
+        return layout[1] * self.dtype.itemsize
+
+    def _read_host(self, prefix, expert):
+        """Read one expert from storage into host memory (raw GGUF bytes, or gate_up and down in the execution dtype).
+
+        Runs on I/O threads: storage and host work only, no device calls.
+        """
+        layout = self.layouts[prefix]
+        if layout[0] == "quantized":
+            # One contiguous read per expert, kept as bytes until it reaches the device.
+            return (self.quantized[0].read(f"{prefix}.experts", expert),)
+        if layout[0] == "gguf":
+            layer = layout[1]
+            return tuple(self.gguf.read(layer, p, expert) for p in ("gate", "up")), self.gguf.read(
+                layer, "down", expert
+            )
+        if layout[0]:
+            gate_up = self.reader.read(f"{prefix}.gate_up_proj", expert)
+        else:
+            gate_up = torch.cat([self.reader.read(f"{prefix}.{expert}.{p}_proj.weight") for p in ("gate", "up")])
+        down = self.reader.read(f"{prefix}.down_proj", expert) if layout[0] else None
+        if down is None:
+            down = self.reader.read(f"{prefix}.{expert}.down_proj.weight")
+        return gate_up.to(self.dtype), down.to(self.dtype)
+
+    def prefetch(self, prefix, experts):
+        """Start reading the experts of ``prefix`` that are neither resident nor already being read."""
+        if self.executor is None:
+            return
+        for expert in experts:
+            key = (prefix, expert)
+            if key not in self.cache and key not in self.pending:
+                self.pending[key] = self.executor.submit(self._read_host, prefix, expert)
+                self.prefetched += 1
+
+    def discard(self, prefix):
+        """Drop the reads started for ``prefix`` that its forward call did not use (wrong predictions)."""
+        for key in [key for key in self.pending if key[0] == prefix]:
+            self.pending.pop(key).cancel()
+
+    def _take_host(self, prefix, expert):
+        """One expert in host memory: from a read already started by :meth:`prefetch`, else read now."""
+        future = self.pending.pop((prefix, expert), None)
+        if future is not None and not future.cancelled():
+            self.prefetch_used += 1
+            return future.result()
+        return self._read_host(prefix, expert)
+
+    def _read(self, prefix, expert):
+        """One expert on the device, for a single use."""
+        tensors = self._take_host(prefix, expert)
+        self.inflight.append(tensors)
+        if self.layouts[prefix][0] == "quantized":
+            return _split_expert(tensors[0].to(self.device, non_blocking=True), self._pool_shapes)
+        if isinstance(tensors[0], tuple):  # GGUF: (gate, up) raw bytes, down raw bytes
+            return tuple(t.to(self.device, non_blocking=True) for t in tensors[0]), tensors[1].to(
+                self.device, non_blocking=True
+            )
+        return tuple(t.to(self.device, non_blocking=True) for t in tensors)
+
+    def release_host_buffers(self):
+        """Called right after a host synchronization: every queued copy has read its host buffer."""
+        self.inflight.clear()
+
+    def install_ahead(self, prefix, experts):
+        """Make guessed experts resident before their layer runs: called once this layer's work is queued, so waiting
+        for their reads and queuing their copies overlaps device work instead of following the next routing copy.
+        Not counted as lookups; the layer's own `acquire` then counts a hit (and `installed_ahead` says how many)."""
+        for expert in experts:
+            key = (prefix, expert)
+            if key in self.cache or key not in self.pending:
+                continue
+            if self._install(key, self._expert_bytes(prefix)) is not None:
+                self.installed_ahead += 1
+
+    def _install(self, key, size, pinned=()):
+        if not self._make_room(key, size, pinned):
+            return None
+        slot = self.free_slots.pop()
+        # Non-blocking: a blocking copy waits for the whole device queue each time (1.6 ms vs 0.13 ms for a
+        # 3.5 MB expert on the M5). The host buffer stays referenced until the next host synchronization.
+        tensors = self._take_host(*key)
+        self.inflight.append(tensors)
+        if self.quantized is not None:
+            self.slot_buffer[slot].copy_(tensors[0], non_blocking=True)
+        else:
+            for pool, tensor in zip(self.pools, tensors):
+                pool[slot].copy_(tensor, non_blocking=True)
+        self.slot_tables[key[0]][key[1]] = slot
+        self.cache[key] = (slot, size)
+        self.resident_bytes += size
+        self.peak_cache_bytes = max(self.peak_cache_bytes, self.resident_bytes)
+        if self.policy == "lfu":
+            self._push(key)
+        return slot
+
+    def acquire(self, prefix, expert, pinned=()):
+        """Make an expert resident in the pool; returns its slot, or None when it runs once without being cached."""
+        key = (prefix, expert)
+        self._count(key)
+        if key in self.cache:
+            self.hits += 1
+            self.cache.move_to_end(key)
+            return self.cache[key][0]
+        self.misses += 1
+        return self._install(key, self._expert_bytes(prefix), pinned)
+
+    def get(self, prefix, expert):
+        """Return ``(gate_up, down, size)`` for one expert, cached or read for this use only."""
+        if self.pooled:
+            slot = self.acquire(prefix, expert)
+            if slot is None:
+                return (*self._read(prefix, expert), self._expert_bytes(prefix))
+            return (*(pool[slot] for pool in self.pools), self._expert_bytes(prefix))
+        key = (prefix, expert)
+        self._count(key)
+        if key in self.cache:
+            self.hits += 1
+            self.cache.move_to_end(key)
+            return self._materialize(prefix, self.cache[key])
+        self.misses += 1
+        size = self._expert_bytes(prefix)
+        admit = self._make_room(key, size)
+        # Keep the GGUF bytes on the device; dequantize each time the expert runs.
+        result = (*self._read(prefix, expert), size)
+        if admit:
+            self.cache[key] = result
+            self.resident_bytes += size
+            self.peak_cache_bytes = max(self.peak_cache_bytes, self.resident_bytes)
+            if self.policy == "lfu":
+                self._push(key)
+        return self._materialize(prefix, result)
+
+    def _materialize(self, prefix, entry):
+        gate_up, down, size = entry
+        layout = self.layouts[prefix]
+        if layout[0] != "gguf":
+            return entry
+        layouts = layout[2]
+        gate_up = torch.cat(
+            [dequantize_gguf(raw, *layouts[p][:3], self.dtype) for raw, p in zip(gate_up, ("gate", "up"))]
+        )
+        return gate_up, dequantize_gguf(down, *layouts["down"][:3], self.dtype), size
+
+    def _readers(self):
+        return [self.reader] + ([self.gguf] if self.gguf else []) + ([self.quantized[0]] if self.quantized else [])
+
+    def preload(self):
+        """Load every expert now (reads in parallel), when the cache holds them all: no storage reads afterwards."""
+        if not self.pooled or self.num_slots < self.total_experts:
+            raise ValueError(
+                f"preload needs room for all {self.total_experts} experts; the cache has {self.num_slots} slots"
+            )
+        for prefix, table in self.slot_tables.items():
+            experts = list(range(table.numel()))
+            self.prefetch(prefix, experts)
+            for expert in experts:
+                self.acquire(prefix, expert)
+            if self.device.type == "mps":
+                torch.mps.synchronize()
+            elif self.device.type == "cuda":
+                torch.cuda.synchronize(self.device)
+            self.release_host_buffers()
+        self.hits = self.misses = 0
+
+    def stats(self):
+        return {
+            "hits": self.hits,
+            "misses": self.misses,
+            "evictions": self.evictions,
+            "not_admitted": self.not_admitted,
+            "policy": self.policy,
+            "slots": self.num_slots,
+            "prefetched": self.prefetched,
+            "prefetch_used": self.prefetch_used,
+            "installed_ahead": self.installed_ahead,
+            "resident_bytes": self.resident_bytes,
+            "peak_cache_bytes": self.peak_cache_bytes,
+            "read_bytes": sum(reader.read_bytes for reader in self._readers()),
+            "read_calls": sum(reader.read_calls for reader in self._readers()),
+        }
+
+
+class _PoolExperts:
+    """The attributes Transformers' experts kernels read from an experts module, with the shared pool as its banks.
+
+    Slot ``num_slots`` marks an expert that is not resident; the kernels' expert-parallel sentinel handling drops it.
+    """
+
+    def __init__(self, module, store):
+        self.module = module
+        self.num_experts = store.num_slots
+        self.gate_up_proj = store.gate_up_pool
+        self.down_proj = store.down_pool
+        self.act_fn = module.act_fn
+        self.has_gate = getattr(module, "has_gate", True)
+        self.has_bias = getattr(module, "has_bias", False)
+        self.is_transposed = getattr(module, "is_transposed", False)
+        self.has_post_expert_norm = getattr(module, "has_post_expert_norm", False)
+        self.post_expert_norm = getattr(module, "post_expert_norm", None)
+        self._is_expert_parallel = True
+
+    def _apply_gate(self, gate_up_out):
+        return self.module._apply_gate(gate_up_out)
+
+
+def _run_expert(module, result, hidden_states, top_k_weights, token, slot, gate_up, down):
+    # Bound the temporary activations during prefill, even when one expert serves many tokens.
+    for start in range(0, token.numel(), module.ssd_token_chunk_size):
+        indices = token[start : start + module.ssd_token_chunk_size]
+        slots = slot[start : start + module.ssd_token_chunk_size]
+        gate, up = torch.nn.functional.linear(hidden_states[indices], gate_up).chunk(2, dim=-1)
+        output = torch.nn.functional.linear(module.act_fn(gate) * up, down)
+        output = output * top_k_weights[indices, slots, None]
+        result.index_add_(0, indices, output.to(result.dtype))
+
+
+def _split_expert(blob, shapes):
+    """Views of one expert's bytes as its quantized tensors: gate_up (weight, scales, biases), then down."""
+    tensors, offset = [], 0
+    for shape, dtype in shapes:
+        size = math.prod(shape) * dtype.itemsize
+        if offset % dtype.itemsize:
+            raise ValueError("Misaligned quantized expert layout")
+        tensors.append(blob[..., offset : offset + size].view(dtype).view(*blob.shape[:-1], *shape))
+        offset += size
+    return tuple(tensors)
+
+
+_MLX_QUANTIZATION_KERNEL = ("kernels-community/mlx-quantization-metal-kernels", 2)
+
+
+def _load_gather_qmm(device):
+    """MLX's quantized MoE matmul from the Hub (Metal) on MPS; elsewhere the slow PyTorch reference below."""
+    if device.type == "mps":
+        try:
+            from .hub_kernels import get_kernel
+
+            return get_kernel(_MLX_QUANTIZATION_KERNEL[0], version=_MLX_QUANTIZATION_KERNEL[1]).gather_qmm
+        except Exception as error:  # the kernels package is optional
+            logger.warning(f"Using the PyTorch reference for quantized experts; the Metal kernel failed: {error}")
+    return _gather_qmm_reference
+
+
+def _gather_qmm_reference(x, w, scales, biases, rhs_indices, group_size, bits, **_):
+    """`gather_qmm(x [S, 1, K], w [E, N, K * bits / 32], ..., rhs_indices [S], transpose=True)` -> [S, 1, N]."""
+    from .metal_quantization import _affine_dequantize_tensor
+
+    output = x.new_empty(*x.shape[:-1], w.shape[1])
+    for expert in torch.unique(rhs_indices).tolist():
+        rows = rhs_indices == expert
+        weight = _affine_dequantize_tensor(w[expert], scales[expert], biases[expert], group_size, bits)
+        output[rows] = x[rows] @ weight.to(x.dtype).T
+    return output
+
+
+def _quantized_mlp(module, store, x, banks, rhs):
+    """Gated expert MLP of rows ``x`` [S, hidden], row ``i`` through expert ``rhs[i]`` of ``banks``.
+
+    ``sorted_indices`` stays off: in mlx-quantization-metal-kernels v2 (torch 2.15, M5) the sorted path returns wrong
+    results once a call has 4 or more rows per expert of the bank (prefill), and it is no faster below that.
+    """
+    _, bits, group_size = store.quantized
+
+    def matmul(inputs, weight, scales, biases):
+        return store.gather_qmm(
+            inputs[:, None, :],
+            weight,
+            scales,
+            biases,
+            rhs_indices=rhs,
+            transpose=True,
+            group_size=group_size,
+            bits=bits,
+        ).squeeze(1)
+
+    return matmul(module._apply_gate(matmul(x, *banks[:3])), *banks[3:])
+
+
+def _sorted_kernel_applies(rows, experts):
+    """Whether `gather_qmm(sorted_indices=True)` takes MLX's batched `gather_qmm_rhs` path: M == 1, at least 16 rows
+    and 4 rows per expert of the bank. That path is several times faster for prefill."""
+    return rows >= 16 and rows >= 4 * experts
+
+
+def _quantized_sorted_forward(module, store, hidden_states, top_k_index, top_k_weights, experts, banks):
+    """Prefill: rows sorted by expert through the sorted `gather_qmm`, over ``banks`` holding only ``experts``.
+
+    Runs in float32: in mlx-quantization-metal-kernels v2 the sorted (NAX) kernel returns wrong results for bfloat16
+    and float16 inputs on the M5, but is correct, and still 4-6x faster than the unsorted path, in float32. Only this
+    call's scales and biases are converted.
+    """
+    _, bits, group_size = store.quantized
+    num_tokens, top_k = top_k_index.shape
+    lookup = torch.zeros(module.num_experts, dtype=torch.long, device=hidden_states.device)
+    lookup[torch.tensor(experts, device=hidden_states.device)] = torch.arange(
+        len(experts), device=hidden_states.device
+    )
+    rhs, order = torch.sort(lookup[top_k_index.reshape(-1)], stable=True)
+    banks = [bank.float() if bank.is_floating_point() else bank for bank in banks]
+
+    def matmul(inputs, weight, scales, biases):
+        return store.gather_qmm(
+            inputs[:, None, :],
+            weight,
+            scales,
+            biases,
+            rhs_indices=rhs,
+            transpose=True,
+            group_size=group_size,
+            bits=bits,
+            sorted_indices=True,
+        ).squeeze(1)
+
+    x = hidden_states.float()[order // top_k]
+    output = matmul(module._apply_gate(matmul(x, *banks[:3])), *banks[3:])
+    output = output * top_k_weights.reshape(-1)[order, None].float()
+    routed = torch.zeros_like(output).index_copy_(0, order, output)
+    return routed.view(num_tokens, top_k, -1).sum(dim=1).to(hidden_states.dtype)
+
+
+def _quantized_pool_forward(module, store, hidden_states, slots, top_k_weights):
+    """Resident quantized experts through `gather_qmm`; non-resident routes (slot ``num_slots``) contribute zero."""
+    num_tokens, top_k = slots.shape
+    rhs = slots.reshape(-1)
+    valid = rhs < store.num_slots
+    weights = (top_k_weights.reshape(-1) * valid)[:, None]
+    output = _quantized_mlp(module, store, hidden_states.repeat_interleave(top_k, dim=0), store.pools, rhs * valid)
+    return (output * weights.to(output.dtype)).view(num_tokens, top_k, -1).sum(dim=1).to(hidden_states.dtype)
+
+
+def streamed_experts_forward(module, hidden_states, top_k_index, top_k_weights):
+    if module.training or torch.is_grad_enabled():
+        raise RuntimeError("SSD expert streaming requires eval() and torch.no_grad() / inference_mode()")
+    store = module.ssd_store
+    if hidden_states.device != store.device or hidden_states.dtype != store.dtype:
+        raise ValueError(
+            "Moving/casting a streamed model after loading is unsupported; reload on the target device/dtype"
+        )
+    prefix = module.ssd_prefix
+    if store.pooled:
+        kernel = ExpertsInterface._global_mapping[store.compute]
+        table = store.slot_tables[prefix]
+        if store.all_resident():
+            # Nothing to load or evict: stay on the device, no host synchronization (counted as one hit per route).
+            store.hits += top_k_index.numel()
+            if store.quantized is not None:
+                return _quantized_pool_forward(module, store, hidden_states, table[top_k_index], top_k_weights)
+            return kernel(_PoolExperts(module, store), hidden_states, table[top_k_index], top_k_weights)
+    # Routing IDs are small; copy them once per layer, rather than synchronizing for every expert. The next MoE layer's
+    # experts are guessed from this layer's hidden states with the next router (the residual stream changes little
+    # from one layer to the next), and the guess rides along in the same copy.
+    next_layer = getattr(module, "ssd_next", None)
+    predict = next_layer is not None and store.executor is not None
+    predict = predict and top_k_index.numel() <= module.ssd_predict_max_routes
+    if predict:
+        next_prefix, router = next_layer
+        guess = torch.nn.functional.linear(hidden_states, router.weight).topk(router.top_k, dim=-1).indices
+        routes = torch.cat((top_k_index.reshape(-1), guess.reshape(-1))).cpu()
+        routing = routes[: top_k_index.numel()].view(top_k_index.shape)
+    else:
+        routing = top_k_index.cpu()
+    # That copy waited for all queued device work, including earlier host-to-device expert copies.
+    store.release_host_buffers()
+    experts = torch.unique(routing).tolist()
+    if experts and not (experts[0] >= 0 and experts[-1] < module.num_experts):
+        raise ValueError("Expert parallelism and sentinel expert IDs are unsupported")
+    # This layer's misses are read in parallel (a window ahead of use, bounding host memory); the guessed next-layer
+    # reads queue behind them.
+    store.prefetch(prefix, experts[: store.window])
+    guessed = torch.unique(routes[top_k_index.numel() :]).tolist() if predict else []
+    if predict:
+        store.prefetch(next_prefix, guessed)
+    try:
+        result = _streamed_experts(module, store, prefix, hidden_states, top_k_index, top_k_weights, routing, experts)
+    finally:
+        store.discard(prefix)
+    if guessed and store.pooled:
+        # This layer's experts are queued on the device: install the next layer's guesses while it computes.
+        store.install_ahead(next_prefix, guessed)
+    return result
+
+
+def _streamed_experts(module, store, prefix, hidden_states, top_k_index, top_k_weights, routing, experts):
+    if not store.pooled:
+        result = torch.zeros_like(hidden_states)
+        for position, expert in enumerate(experts):
+            store.prefetch(prefix, experts[position + 1 : position + 1 + store.window])
+            token, slot = (t.to(hidden_states.device) for t in torch.where(routing == expert))
+            gate_up, down, _ = store.get(prefix, expert)
+            _run_expert(module, result, hidden_states, top_k_weights, token, slot, gate_up, down)
+        return result
+    pinned, uncached = set(), []
+    for position, expert in enumerate(experts):
+        store.prefetch(prefix, experts[position + 1 : position + 1 + store.window])
+        if store.acquire(prefix, expert, pinned) is None:
+            uncached.append(expert)
+        else:
+            pinned.add((prefix, expert))
+    if store.quantized is not None and _sorted_kernel_applies(top_k_index.numel(), len(experts)):
+        # Prefill-sized call: one sorted gather_qmm over a compact bank of this call's experts, cached or not.
+        per_expert = []
+        for expert in experts:
+            if (prefix, expert) in pinned:
+                slot = store.cache[(prefix, expert)][0]
+                per_expert.append([pool[slot] for pool in store.pools])
+            else:
+                per_expert.append(store._read(prefix, expert))
+        banks = [torch.stack(parts) for parts in zip(*per_expert)]
+        return _quantized_sorted_forward(module, store, hidden_states, top_k_index, top_k_weights, experts, banks)
+    if pinned and store.quantized is not None:
+        slots = store.slot_tables[prefix][top_k_index]
+        result = _quantized_pool_forward(module, store, hidden_states, slots, top_k_weights)
+    elif pinned:
+        kernel = ExpertsInterface._global_mapping[store.compute]
+        table = store.slot_tables[prefix]
+        result = kernel(_PoolExperts(module, store), hidden_states, table[top_k_index], top_k_weights)
+    else:
+        result = torch.zeros_like(hidden_states)
+    # Experts the cache did not admit (budget smaller than one call's working set, or LFU declined) run once each.
+    for position, expert in enumerate(uncached):
+        store.prefetch(prefix, uncached[position + 1 : position + 1 + store.window])
+        token, slot = (t.to(hidden_states.device) for t in torch.where(routing == expert))
+        tensors = store._read(prefix, expert)
+        if store.quantized is not None:
+            banks = [tensor[None] for tensor in tensors]
+            rhs = torch.zeros_like(token)
+            output = _quantized_mlp(module, store, hidden_states[token], banks, rhs) * top_k_weights[token, slot, None]
+            result.index_add_(0, token, output.to(result.dtype))
+        else:
+            _run_expert(module, result, hidden_states, top_k_weights, token, slot, *tensors)
+    return result
+
+
+def load_moe_from_ssd(
+    directory,
+    *,
+    device="cpu",
+    dtype=torch.float32,
+    cache_bytes=0,
+    token_chunk_size=256,
+    experts_gguf=None,
+    bypass_page_cache=False,
+    cache_policy="lru",
+    experts_implementation="grouped_mm",
+    io_threads=4,
+    prefetch_next_layer=True,
+    predict_max_routes=64,
+    quantized_experts=None,
+    preload_experts=False,
+):
+    """Load a local, unquantized Qwen MoE checkpoint without allocating resident expert banks.
+
+    With ``experts_gguf`` (a llama.cpp GGUF of the same model), the experts are streamed from that file instead, in its
+    own quantization (Q8_0 is dequantized on the device at each use); ``cache_bytes`` then counts the GGUF's bytes.
+
+    Supports ``qwen3_moe`` (original per-expert or packed experts) and the text model of ``qwen3_5_moe``.
+    Does not require Accelerate, checkpoint conversion, kernels, or a second copy of the weights.
+    The returned model is inference-only: do not train, move/cast, save_pretrained, compile, or change
+    its experts implementation. Reload the original checkpoint to obtain an ordinary model.
+    """
+    if dtype not in _DTYPES.values() or token_chunk_size <= 0:
+        raise ValueError("Use a floating dtype (float32/float16/bfloat16) and positive token_chunk_size")
+    raw_config = json.loads((Path(directory) / "config.json").read_text())
+    model_type = raw_config.get("model_type")
+    if model_type not in _ARCHITECTURES or raw_config.get("quantization_config"):
+        raise ValueError(f"This prototype supports only unquantized {sorted(_ARCHITECTURES)} checkpoints")
+    load_config, model_class, experts_class, rotary_class, prefix, skipped = _ARCHITECTURES[model_type]
+    config = load_config(directory)
+    config._attn_implementation = "eager"
+    config._experts_implementation = "ssd_streaming"
+    ExpertsInterface.register("ssd_streaming", streamed_experts_forward)
+    # Resolve cuda -> cuda:0 and analogous device aliases for forward validation.
+    device = torch.empty(0, device=device).device
+    reader = SafetensorsReader(directory, bypass_page_cache)
+    gguf = GGUFExpertReader(experts_gguf, bypass_page_cache) if experts_gguf else None
+    store = ExpertStore(
+        reader,
+        cache_bytes,
+        device,
+        dtype,
+        gguf,
+        policy=cache_policy,
+        io_threads=io_threads,
+        quantized=quantized_experts,
+    )
+    if experts_implementation not in ("grouped_mm", "batched_mm"):
+        raise ValueError("experts_implementation must be 'grouped_mm' or 'batched_mm'")
+    store.compute = experts_implementation
+
+    def checkpoint_name(name):
+        return prefix + name.removeprefix("model.") if name.startswith("model.") else name
+
+    with torch.device("meta"):
+        model = model_class(config)
+    experts_modules = []
+    consumed = {name for name in reader.tensors if name.startswith(skipped)} if skipped else set()
+    for name, module in model.named_modules():
+        if isinstance(module, experts_class):
+            consumed.update(store.register(checkpoint_name(name), module))
+            # Keep no meta Parameters that an offload hook could materialize as whole banks.
+            module.register_parameter("gate_up_proj", None)
+            module.register_parameter("down_proj", None)
+            module.ssd_store = store
+            module.ssd_prefix = checkpoint_name(name)
+            module.ssd_token_chunk_size = token_chunk_size
+            module.ssd_predict_max_routes = predict_max_routes
+            experts_modules.append((name, module))
+    # Load dense weights individually; peak host staging is one dense tensor, not one shard.
+    for name, parameter in list(model.named_parameters()):
+        source = checkpoint_name(name)
+        if config.tie_word_embeddings and name == "lm_head.weight" and name not in reader.tensors:
+            source = checkpoint_name("model.embed_tokens.weight")
+        if source not in reader.tensors or reader.shape(source) != tuple(parameter.shape):
+            raise ValueError(f"Missing or incompatible dense tensor: {source}")
+        value = reader.read(source).to(device=device, dtype=dtype)
+        parent, _, attr = name.rpartition(".")
+        model.get_submodule(parent).register_parameter(attr, torch.nn.Parameter(value, requires_grad=False))
+        consumed.add(source)
+    # Each MoE layer knows the next one's router, to guess and prefetch its experts (decode-sized calls only).
+    for (name, module), (next_name, _) in zip(experts_modules, experts_modules[1:] + [(None, None)]):
+        router = model.get_submodule(next_name.rpartition(".")[0]).gate if next_name and prefetch_next_layer else None
+        module.ssd_next = (checkpoint_name(next_name), router) if router is not None else None
+    unexpected = set(reader.tensors) - consumed
+    if unexpected:
+        raise ValueError(f"Unsupported checkpoint tensors: {sorted(unexpected)[:10]}")
+    model.tie_weights()
+    # RoPE has nonpersistent buffers, so checkpoint loading cannot materialize them.
+    model.model.rotary_emb = rotary_class(config).to(device)
+    meta = [n for n, t in list(model.named_parameters()) + list(model.named_buffers()) if t.is_meta]
+    if meta:
+        raise RuntimeError(f"Unmaterialized model state after streaming load: {meta[:10]}")
+    model.eval()
+    model.ssd_store = store
+    if preload_experts:
+        store.preload()
+    # Exclude dense startup I/O from expert runtime counters.
+    reader.read_bytes = reader.read_calls = 0
+    if store.gguf is not None:
+        store.gguf.read_bytes = store.gguf.read_calls = 0
+    return model
+
+
+# Backward-compatible name used by the first version of this prototype.
+load_qwen3_moe_from_ssd = load_moe_from_ssd
+
+
+def _checkpoint_prefix(reader, name):
+    """The checkpoint key prefix of the experts module ``name``: the same path, possibly under another root (e.g.
+    ``model.language_model.``), in the packed (``gate_up_proj``) or per-expert (``0.gate_proj.weight``) layout."""
+    suffix = name.split(".", 1)[1] if name.startswith("model.") else name
+    found = {
+        key.rsplit(".gate_up_proj", 1)[0] if key.endswith(".gate_up_proj") else key.rsplit(".0.gate_proj.weight", 1)[0]
+        for key in reader.tensors
+        if key.endswith((f"{suffix}.gate_up_proj", f"{suffix}.0.gate_proj.weight"))
+    }
+    if len(found) != 1:
+        raise ValueError(f"Cannot find the checkpoint experts of {name} (candidates: {sorted(found)})")
+    return found.pop()
+
+
+def prepare_experts_offload(model, checkpoint_files, *, dtype, device, options):
+    """Called by ``from_pretrained(..., experts_offload=...)`` on the meta-initialized model, before any weight loads.
+
+    Replaces every experts bank with the streaming store: the bank parameters are removed (so the loader never
+    materializes them), the experts dispatch to ``ssd_streaming``, and the expert tensors are reported as consumed so
+    the loader skips them. ``options`` are the keyword arguments of :func:`load_moe_from_ssd` that concern the store:
+    ``cache_bytes`` (required), ``cache_policy``, ``io_threads``, ``prefetch_next_layer``, ``experts_implementation``,
+    ``bypass_page_cache``, ``token_chunk_size``, ``predict_max_routes``.
+    """
+    options = dict(options)
+    unknown = set(options) - {
+        "cache_bytes",
+        "cache_policy",
+        "io_threads",
+        "prefetch_next_layer",
+        "experts_implementation",
+        "bypass_page_cache",
+        "token_chunk_size",
+        "predict_max_routes",
+        "quantized_experts",
+    }
+    if unknown or "cache_bytes" not in options:
+        raise ValueError(f"experts_offload needs `cache_bytes`; unknown options: {sorted(unknown)}")
+    if not checkpoint_files or not all(str(f).endswith(".safetensors") for f in checkpoint_files):
+        raise ValueError("experts_offload streams experts from safetensors checkpoints only")
+    if dtype not in _DTYPES.values():
+        raise ValueError("experts_offload needs a floating dtype (float32/float16/bfloat16)")
+    ExpertsInterface.register("ssd_streaming", streamed_experts_forward)
+    device = torch.empty(0, device=device).device
+    reader = SafetensorsReader(Path(checkpoint_files[0]).parent, options.get("bypass_page_cache", False))
+    store = ExpertStore(
+        reader,
+        options["cache_bytes"],
+        device,
+        dtype,
+        policy=options.get("cache_policy", "lru"),
+        io_threads=options.get("io_threads", 4),
+        quantized=options.get("quantized_experts"),
+    )
+    store.compute = options.get("experts_implementation", "grouped_mm")
+    experts = [
+        (name, module)
+        for name, module in model.named_modules()
+        if hasattr(module, "_apply_gate") and isinstance(getattr(module, "gate_up_proj", None), torch.nn.Parameter)
+    ]
+    if not experts:
+        raise ValueError(f"{type(model).__name__} has no experts module that can be offloaded")
+    consumed = set()
+    for name, module in experts:
+        if module.has_bias or module.is_transposed or not module.is_concatenated or module.has_post_expert_norm:
+            raise ValueError(
+                f"experts_offload supports gated, concatenated, untransposed experts without bias: {name}"
+            )
+        prefix = _checkpoint_prefix(reader, name)
+        consumed.update(store.register(prefix, module))
+        module.register_parameter("gate_up_proj", None)
+        module.register_parameter("down_proj", None)
+        module._is_hf_initialized = True  # nothing to initialize: the banks live in the checkpoint
+        module.config._experts_implementation = "ssd_streaming"
+        module.ssd_store = store
+        module.ssd_prefix = prefix
+        module.ssd_token_chunk_size = options.get("token_chunk_size", 256)
+        module.ssd_predict_max_routes = options.get("predict_max_routes", 64)
+        module.ssd_next = None
+    if options.get("prefetch_next_layer", True):
+        for (_, module), (next_name, next_module) in zip(experts, experts[1:]):
+            router = getattr(model.get_submodule(next_name.rpartition(".")[0]), "gate", None)
+            if router is not None and hasattr(router, "weight") and hasattr(router, "top_k"):
+                module.ssd_next = (next_module.ssd_prefix, router)
+    model.ssd_store = store
+    return consumed
+
+
+def quantize_experts(checkpoint, output, *, bits=4, group_size=64, device="cpu"):
+    """Write the experts of a safetensors MoE checkpoint, quantized for `ExpertStore(quantized=output)`.
+
+    MLX's affine format, the one `gather_qmm` reads: per projection (``gate_up_proj``, then ``down_proj``), ``weight``
+    [out, in * bits / 32] uint32, ``scales`` and ``biases`` [out, in / group_size] in the checkpoint dtype. The six
+    tensors of one expert are stored back to back as one uint8 row of ``{prefix}.experts`` [experts, bytes], so a miss
+    is a single contiguous read. One file per experts module plus an index. Quantizes with the Metal kernel on MPS, else with the PyTorch reference (same layout).
+    Peak memory is one experts module.
+    """
+    from safetensors.torch import save_file
+
+    from .metal_quantization import _affine_quantize_tensor
+
+    device = torch.device(device)
+    quantize = lambda weight: _affine_quantize_tensor(weight, group_size, bits)  # noqa: E731
+    quantizer = "pytorch-reference"
+    if device.type == "mps":
+        from .hub_kernels import get_kernel
+
+        kernel = get_kernel(_MLX_QUANTIZATION_KERNEL[0], version=_MLX_QUANTIZATION_KERNEL[1])
+        quantize = lambda weight: kernel.quantize(weight, group_size=group_size, bits=bits)  # noqa: E731
+        quantizer = "mlx-quantization-metal-kernels"
+    reader = SafetensorsReader(checkpoint)
+    output = Path(output)
+    output.mkdir(parents=True, exist_ok=True)
+    packed = sorted(name.removesuffix(".gate_up_proj") for name in reader.tensors if name.endswith(".gate_up_proj"))
+    per_expert = sorted(
+        name.removesuffix(".0.gate_proj.weight") for name in reader.tensors if name.endswith(".0.gate_proj.weight")
+    )
+    weight_map = {}
+    for index, prefix in enumerate(packed + per_expert):
+        if prefix in packed:
+            experts = reader.shape(f"{prefix}.gate_up_proj")[0]
+
+            def read(expert):
+                return reader.read(f"{prefix}.gate_up_proj", expert), reader.read(f"{prefix}.down_proj", expert)
+
+        else:
+            experts = sum(
+                1 for name in reader.tensors if re.fullmatch(rf"{re.escape(prefix)}\.\d+\.gate_proj\.weight", name)
+            )
+
+            def read(expert):
+                gate_up = torch.cat([reader.read(f"{prefix}.{expert}.{p}_proj.weight") for p in ("gate", "up")])
+                return gate_up, reader.read(f"{prefix}.{expert}.down_proj.weight")
+
+        blobs = []
+        for expert in range(experts):
+            parts = []
+            for weight in read(expert):
+                weight_q, scales, biases = quantize(weight.to(device))
+                parts += [weight_q, scales.to(weight.dtype), biases.to(weight.dtype)]
+            # Expert-major: one expert is one contiguous run of bytes, read in one call.
+            blobs.append(torch.cat([part.cpu().contiguous().view(torch.uint8).reshape(-1) for part in parts]))
+        filename = f"experts-{index:05d}.safetensors"
+        save_file({f"{prefix}.experts": torch.stack(blobs)}, output / filename, {"format": "pt"})
+        weight_map[f"{prefix}.experts"] = filename
+        logger.info(f"quantized {prefix}: {experts} experts")
+    (output / "model.safetensors.index.json").write_text(json.dumps({"metadata": {}, "weight_map": weight_map}))
+    info = {"format": _QUANTIZED_FORMAT, "bits": bits, "group_size": group_size, "quantizer": quantizer}
+    (output / "quantization.json").write_text(json.dumps(info, indent=2))
+    return output
