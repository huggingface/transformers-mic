+class SSDGGUFExpertsTest(unittest.TestCase):
+    def test_q8_0_experts_from_gguf_match_dequantized_reference(self):
+        torch.manual_seed(5)
+        config = Qwen3MoeConfig(
+            vocab_size=64,
+            hidden_size=32,
+            intermediate_size=64,
+            moe_intermediate_size=32,
+            num_hidden_layers=2,
+            num_attention_heads=2,
+            num_key_value_heads=1,
+            head_dim=16,
+            num_experts=4,
+            num_experts_per_tok=2,
+        )
+        config._experts_implementation = "eager"
+        config._attn_implementation = "eager"
+        reference = Qwen3MoeForCausalLM(config).eval()
+        tensors = {}
+        for layer_index, layer in enumerate(reference.model.layers):
+            experts = layer.mlp.experts
+            gate, up = experts.gate_up_proj.data.chunk(2, dim=1)
+            for projection, bank in (("gate", gate), ("up", up), ("down", experts.down_proj.data)):
+                raws, dequantized = zip(*(quantize_q8_0(matrix) for matrix in bank))
+                rows, columns = bank.shape[1:]
+                tensors[f"blk.{layer_index}.ffn_{projection}_exps.weight"] = (
+                    [columns, rows, bank.shape[0]],
+                    8,
