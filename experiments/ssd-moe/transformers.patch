+    def test_preload_reads_every_expert_once_up_front(self):
+        with tempfile.TemporaryDirectory() as directory:
+            reference, path = self.make_checkpoint(directory)
+            ids = torch.tensor([[1, 7, 3, 9, 2]])
+            with self.assertRaises(ValueError):
+                load_moe_from_ssd(path, cache_bytes=3 * 3 * 8 * 16 * 4, preload_experts=True)
+            streamed = load_moe_from_ssd(path, cache_bytes=8 * 3 * 8 * 16 * 4, preload_experts=True)
+            store = streamed.ssd_store
+            self.assertTrue(store.all_resident())
+            read_bytes = store.stats()["read_bytes"]
+            with torch.no_grad():
+                expected = reference.generate(ids, max_new_tokens=6, do_sample=False, pad_token_id=0)
+                actual = streamed.generate(ids, max_new_tokens=6, do_sample=False, pad_token_id=0)
+            torch.testing.assert_close(actual, expected)
+            self.assertEqual((store.misses, store.stats()["read_bytes"]), (0, read_bytes))
