+"""Run Qwen MoE (qwen3_moe, Qwen3.5/3.6 qwen3_5_moe text) with routed SSD reads and no added runtime dependencies.
+
+From the repository root, with a local, complete, unquantized safetensors checkpoint:
+
+    PYTHONPATH=src python examples/generate/ssd_moe.py /path/to/Qwen3-30B-A3B \
+        --device mps --dtype bfloat16 --cache-mib 4096 --max-new-tokens 32
+
+For a comparison, run a separate process with --mode eager (only if the full model fits), or
+--mode offload for vanilla from_pretrained(device_map="auto") with Accelerate CPU/disk offload.
+Use --runs 2 to observe first-pass versus reused expert-cache behavior. Neither is guaranteed to
+be storage-cold: the OS page cache is intentionally left alone. read_bytes is logical file I/O.
+The CLI generates a fixed number of greedy tokens, ignoring EOS, for comparable timings.
+Streaming needs no checkpoint download, conversion, Accelerate, vLLM, llama.cpp, or kernels package.
+"""
+
+import argparse
+import json
+import platform
+import resource
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+
+from transformers import AutoTokenizer
+from transformers.integrations.moe import ExpertsInterface
+from transformers.integrations.ssd_moe import _ARCHITECTURES, load_moe_from_ssd
+
+
+def layerwise_experts_forward(module, hidden_states, top_k_index, top_k_weights):
+    """Comparison policy: materialize every expert in the current layer, then call its original eager forward.
+
+    This is a whole-bank I/O baseline, NOT Accelerate's implementation. No bank survives the call.
+    """
+    reader = module.ssd_store.reader
+    prefix = module.ssd_prefix
+    dtype, device = hidden_states.dtype, hidden_states.device
+    if module.ssd_store.layouts[prefix][0]:
+        gate_up = reader.read(f"{prefix}.gate_up_proj")
+        down = reader.read(f"{prefix}.down_proj")
+    else:
+        gate_up = torch.empty(module.num_experts, 2 * module.intermediate_dim, module.hidden_dim, dtype=dtype)
+        down = torch.empty(module.num_experts, module.hidden_dim, module.intermediate_dim, dtype=dtype)
+        for expert in range(module.num_experts):
+            gate_up[expert, : module.intermediate_dim].copy_(reader.read(f"{prefix}.{expert}.gate_proj.weight"))
+            gate_up[expert, module.intermediate_dim :].copy_(reader.read(f"{prefix}.{expert}.up_proj.weight"))
+            down[expert].copy_(reader.read(f"{prefix}.{expert}.down_proj.weight"))
+    bank = SimpleNamespace(
+        num_experts=module.num_experts,
+        act_fn=module.act_fn,
+        gate_up_proj=gate_up.to(device, dtype),
+        down_proj=down.to(device, dtype),
+    )
+    return type(module).forward.__wrapped__(bank, hidden_states, top_k_index, top_k_weights)
+
+
+def storage_read_bytes():
+    """Linux kernel-accounted storage reads, including page-cache effects; unavailable on other systems."""
+    path = Path("/proc/self/io")
+    if path.exists():
+        return int(dict(line.split(": ") for line in path.read_text(encoding="utf-8").splitlines())["read_bytes"])
+    return None
+
+
+def synchronize(device):
+    if device.type == "cuda":
+        torch.cuda.synchronize(device)
+    elif device.type == "mps":
+        torch.mps.synchronize()
+
+
+def counters(model):
+    return model.ssd_store.stats() if hasattr(model, "ssd_store") else {}
+
+
+def counter_delta(before, after):
+    return {
+        key: value if key in ("resident_bytes", "peak_cache_bytes") else value - before[key]
+        for key, value in after.items()
+    }
+
+
+@torch.inference_mode()
+def run(model, input_ids, new_tokens, prefill_chunk_size):
+    device = input_ids.device
+    before = counters(model)
+    storage_before = storage_read_bytes()
+    synchronize(device)
+    start = time.perf_counter()
+    past = None
+    for offset in range(0, input_ids.shape[1], prefill_chunk_size):
+        outputs = model(
+            input_ids[:, offset : offset + prefill_chunk_size],
+            past_key_values=past,
+            use_cache=True,
+            logits_to_keep=1,
+        )
+        past = outputs.past_key_values
+    token = outputs.logits[:, -1].argmax(-1, keepdim=True)
+    synchronize(device)
+    prefill_s = time.perf_counter() - start
+    after_prefill = counters(model)
+    generated = [token]
+    synchronize(device)
+    start = time.perf_counter()
+    for _ in range(new_tokens - 1):
+        outputs = model(token, past_key_values=past, use_cache=True, logits_to_keep=1)
+        past = outputs.past_key_values
+        token = outputs.logits[:, -1].argmax(-1, keepdim=True)
+        generated.append(token)
+    synchronize(device)
+    decode_s = time.perf_counter() - start
+    storage_after = storage_read_bytes()
+    return {
+        "prompt_tokens": input_ids.shape[1],
+        "generated_token_ids": torch.cat(generated, dim=1)[0].tolist(),
+        "time_to_first_token_s": prefill_s,
+        "prefill_tokens_per_s": input_ids.shape[1] / prefill_s,
+        "decode_s": decode_s,
+        "decode_tokens_per_s": (new_tokens - 1) / decode_s if new_tokens > 1 else None,
+        "prefill_io": counter_delta(before, after_prefill),
+        "decode_io": counter_delta(after_prefill, counters(model)),
+        "kernel_storage_read_bytes": None if storage_before is None else storage_after - storage_before,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("checkpoint", type=Path, help="Local directory containing config, tokenizer and all shards")
+    parser.add_argument(
+        "--mode",
+        choices=("streaming", "eager", "layerwise", "offload"),
+        default="streaming",
+        help="offload = vanilla from_pretrained(device_map='auto') with Accelerate CPU/disk offload",
+    )
+    parser.add_argument("--offload-gpu-mib", type=int, default=18 * 1024, help="offload mode: GPU memory budget")
+    parser.add_argument("--offload-cpu-mib", type=int, default=8 * 1024, help="offload mode: CPU memory budget")
+    parser.add_argument("--offload-folder", type=Path, help="offload mode: folder for weights offloaded to disk")
+    parser.add_argument("--device", default="cpu", help="cpu, mps, cuda, or cuda:N")
+    parser.add_argument("--dtype", choices=("float32", "float16", "bfloat16"), default="float32")
+    parser.add_argument(
+        "--cache-mib", type=float, default=256, help="Global device expert-cache budget, not total memory"
+    )
+    parser.add_argument(
+        "--experts-gguf",
+        type=Path,
+        help="streaming mode: read the experts from this llama.cpp GGUF of the same model (e.g. Q8_0) instead",
+    )
+    parser.add_argument(
+        "--use-kernels",
+        action="store_true",
+        help="Use Hub kernels (the `kernels` package) for supported layers, e.g. Qwen3.5/3.6 linear attention",
+    )
+    parser.add_argument("--expert-token-chunk-size", type=int, default=256)
+    parser.add_argument("--prefill-chunk-size", type=int, default=256, help="Tokens per model prefill call")
+    parser.add_argument("--max-new-tokens", type=int, default=16)
+    parser.add_argument("--runs", type=int, default=2)
+    parser.add_argument("--threads", type=int, default=4, help="PyTorch CPU intra-op threads")
+    parser.add_argument("--prompt", default="The capital of France is")
+    parser.add_argument("--prompt-file", type=Path, help="Read the prompt from a file (overrides --prompt)")
+    parser.add_argument(
+        "--chat",
+        action="store_true",
+        help="Apply the chat template (thinking disabled), as an OpenAI chat server would",
+    )
+    parser.add_argument("--output", type=Path, help="Optional path for the JSON report")
+    args = parser.parse_args()
+    if min(args.max_new_tokens, args.runs, args.prefill_chunk_size, args.threads, args.expert_token_chunk_size) < 1:
+        parser.error("Token counts, chunk sizes, runs and threads must be positive")
+    if args.cache_mib < 0:
+        parser.error("Cache size must be nonnegative")
+    if args.experts_gguf and args.mode != "streaming":
+        parser.error("--experts-gguf needs --mode streaming")
+    torch.set_num_threads(args.threads)
+    device = torch.device(args.device)
+    dtype = getattr(torch, args.dtype)
+    tokenizer = AutoTokenizer.from_pretrained(args.checkpoint, local_files_only=True)
+    if args.prompt_file:
+        args.prompt = args.prompt_file.read_text()
+    if args.chat:
+        inputs = tokenizer.apply_chat_template(
+            [{"role": "user", "content": args.prompt}],
+            add_generation_prompt=True,
+            enable_thinking=False,
+            return_dict=True,
+            return_tensors="pt",
+        )["input_ids"].to(device)
+    else:
+        inputs = tokenizer(args.prompt, return_tensors="pt").input_ids.to(device)
+    if inputs.numel() == 0:
+        parser.error("Prompt must tokenize to at least one token")
+    start = time.perf_counter()
+    if args.mode in ("streaming", "layerwise"):
+        model = load_moe_from_ssd(
+            args.checkpoint,
+            device=device,
+            dtype=dtype,
+            cache_bytes=int(args.cache_mib * 1024**2) if args.mode == "streaming" else 0,
+            token_chunk_size=args.expert_token_chunk_size,
+            experts_gguf=args.experts_gguf,
+        )
+        if args.mode == "layerwise":
+            ExpertsInterface.register("ssd_layerwise", layerwise_experts_forward)
+            model.set_experts_implementation("ssd_layerwise")
+    else:
+        model_type = json.loads((args.checkpoint / "config.json").read_text())["model_type"]
+        model_class = _ARCHITECTURES[model_type][1]
+        kwargs = {"local_files_only": True, "dtype": dtype, "attn_implementation": "eager"}
+        if args.mode == "eager":
+            model = model_class.from_pretrained(args.checkpoint, experts_implementation="eager", **kwargs).to(device)
+        else:
+            if device.type != "cuda" or args.offload_folder is None:
+                parser.error("offload mode needs --device cuda[:N] and --offload-folder")
+            model = model_class.from_pretrained(
+                args.checkpoint,
+                device_map="auto",
+                max_memory={device.index or 0: f"{args.offload_gpu_mib}MiB", "cpu": f"{args.offload_cpu_mib}MiB"},
+                offload_folder=str(args.offload_folder),
+                **kwargs,
+            )
+        model.eval()
+    if args.use_kernels:
+        # Kernelize after loading: the streamed experts are not a kernelized layer, so they are left as they are.
+        model.set_use_kernels(True)
+    synchronize(device)
+    report = {
+        "checkpoint": str(args.checkpoint.resolve()),
+        "mode": args.mode,
+        "device": str(device),
+        "dtype": args.dtype,
+        "torch": torch.__version__,
+        "platform": platform.platform(),
+        "threads": args.threads,
+        "prompt": args.prompt,
+        "chat_template": args.chat,
+        "experts_gguf": str(args.experts_gguf.resolve()) if args.experts_gguf else None,
+        "use_kernels": args.use_kernels,
+        "cache_budget_bytes": int(args.cache_mib * 1024**2) if args.mode == "streaming" else None,
+        "prefill_chunk_size": args.prefill_chunk_size,
+        "expert_token_chunk_size": args.expert_token_chunk_size,
+        "load_s": time.perf_counter() - start,
+        "resident_parameter_bytes": sum(p.numel() * p.element_size() for p in model.parameters()),
+        "storage_cold": False,
+        "io_note": "Logical requested file bytes, not physical SSD traffic; OS page cache is not controlled.",
+        "runs": [],
+    }
+    for _ in range(args.runs):
+        result = run(model, inputs, args.max_new_tokens, args.prefill_chunk_size)
+        result["generated_text"] = tokenizer.decode(result["generated_token_ids"])
+        report["runs"].append(result)
+    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    report["process_peak_rss_bytes"] = rss if platform.system() == "Darwin" else rss * 1024
+    if device.type == "cuda":
+        report["gpu"] = torch.cuda.get_device_name(device)
+        report["device_peak_allocated_bytes"] = torch.cuda.max_memory_allocated(device)
+    elif device.type == "mps":
+        report["device_current_allocated_bytes"] = torch.mps.current_allocated_memory()
+    text = json.dumps(report, indent=2)
+    if args.output:
+        args.output.write_text(text + "\n")
+    print(text)
+
+
+if __name__ == "__main__":
+    main()
