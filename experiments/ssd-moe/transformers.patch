+class QuantizedExpertsTest(unittest.TestCase):
+    """Experts quantized by `quantize_experts` (MLX affine format) stream like BF16 ones and run through gather_qmm."""
+
+    def test_quantized_experts_match_dequantized_reference(self):
+        from transformers.integrations.metal_quantization import _affine_dequantize_tensor
+        from transformers.integrations.ssd_moe import _split_expert, quantize_experts
+
+        torch.manual_seed(11)
+        config = Qwen3MoeConfig(
+            vocab_size=64,
+            hidden_size=16,
+            intermediate_size=24,
+            moe_intermediate_size=8,
+            num_hidden_layers=2,
+            num_attention_heads=2,
+            num_key_value_heads=1,
+            head_dim=8,
+            num_experts=4,
+            num_experts_per_tok=2,
+        )
+        config._experts_implementation = "eager"
+        config._attn_implementation = "eager"
+        model = Qwen3MoeForCausalLM(config).eval()
+        # 12 tokens x top-2 over 4 experts: prefill takes the sorted (compact bank) path, decode the pool path.
+        ids = torch.tensor([[1, 7, 3, 9, 2, 11, 5, 13, 4, 8, 6, 10]])
+        with tempfile.TemporaryDirectory() as directory:
+            path, quantized = Path(directory) / "model", Path(directory) / "experts-q8"
+            model.save_pretrained(path)
+            quantize_experts(path, quantized, bits=8, group_size=8)
+            blob = load_file(quantized / "experts-00000.safetensors")["model.layers.0.mlp.experts.experts"]
+            self.assertEqual((blob.dtype, blob.shape[0]), (torch.uint8, 4))
+            # Reference: the same model with its experts replaced by the dequantized ones.
+            shapes = [
+                ((16, 16 * 8 // 32), torch.uint32),
+                ((16, 16 // 8), torch.float32),
+                ((16, 16 // 8), torch.float32),
+                ((16, 8 * 8 // 32), torch.uint32),
+                ((16, 8 // 8), torch.float32),
+                ((16, 8 // 8), torch.float32),
+            ]
+            with torch.no_grad():
+                for index, layer in enumerate(model.model.layers):
+                    blobs = load_file(quantized / f"experts-{index:05d}.safetensors")[
+                        f"model.layers.{index}.mlp.experts.experts"
+                    ]
+                    experts = [_split_expert(blobs[e], shapes) for e in range(4)]
+                    for offset, projection in ((0, "gate_up_proj"), (3, "down_proj")):
+                        dequantized = torch.stack(
+                            [_affine_dequantize_tensor(*tensors[offset : offset + 3], 8, 8) for tensors in experts]
+                        )
+                        getattr(layer.mlp.experts, projection).copy_(dequantized)
+                expected = model.generate(ids, max_new_tokens=6, do_sample=False, pad_token_id=0)
+                expected_logits = model(ids).logits
+            for slots in (1, 3, 8):
+                with self.subTest(slots=slots):
+                    streamed = load_moe_from_ssd(
+                        path, cache_bytes=slots * 1000, quantized_experts=quantized, io_threads=2
+                    )
+                    self.assertEqual(streamed.ssd_store.num_slots, slots * 1000 // streamed.ssd_store.slot_bytes)
+                    with torch.no_grad():
+                        torch.testing.assert_close(streamed(ids).logits, expected_logits, atol=1e-5, rtol=1e-4)
+                        actual = streamed.generate(ids, max_new_tokens=6, do_sample=False, pad_token_id=0)
+                    torch.testing.assert_close(actual, expected)
+
+    def test_sorted_kernel_condition(self):
+        from transformers.integrations.ssd_moe import _sorted_kernel_applies
+
+        self.assertFalse(_sorted_kernel_applies(8, 1))  # decode: fewer than 16 rows
+        self.assertFalse(_sorted_kernel_applies(63, 16))  # under 4 rows per expert
+        self.assertTrue(_sorted_kernel_applies(64, 16))
