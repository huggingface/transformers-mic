+            write_gguf(path / "experts.gguf", tensors)
+            # One Q8_0 expert is 3 * 32 * (32 / 32) * 34 = 3264 bytes: room for one, so every switch evicts.
+            streamed = load_moe_from_ssd(path, cache_bytes=3264, experts_gguf=path / "experts.gguf")
