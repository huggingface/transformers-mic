+"""Experimental, inference-only Qwen MoE expert streaming, without Accelerate or native I/O dependencies.
+
+Supported checkpoints: ``qwen3_moe`` and the text model of ``qwen3_5_moe`` (Qwen3.5/3.6 MoE), unquantized.
+The experts can instead come from a llama.cpp GGUF of the same model (Q8_0, F16, BF16 or F32 expert tensors), so that
+the streamed bytes match what llama.cpp-based engines read; dense weights still come from the safetensors checkpoint.
+
+This is a single-device proof of concept, not a general replacement for ``from_pretrained``.
+The checkpoint remains on disk; dense parameters and a byte-bounded expert LRU live on the device.
+Reads use ordinary buffered file I/O, so read_bytes measures requested bytes, NOT physical SSD traffic.
+"""
+
+import json
+import math
+import re
+import struct
+from collections import OrderedDict
+from pathlib import Path
+
+import torch
+from safetensors import safe_open
+
+from ..models.qwen3_5_moe.configuration_qwen3_5_moe import Qwen3_5MoeConfig, Qwen3_5MoeTextConfig
+from ..models.qwen3_5_moe.modeling_qwen3_5_moe import (
+    Qwen3_5MoeExperts,
+    Qwen3_5MoeForCausalLM,
+    Qwen3_5MoeTextRotaryEmbedding,
+)
+from ..models.qwen3_moe.configuration_qwen3_moe import Qwen3MoeConfig
+from ..models.qwen3_moe.modeling_qwen3_moe import (
+    Qwen3MoeExperts,
+    Qwen3MoeForCausalLM,
+    Qwen3MoeRotaryEmbedding,
+)
+from .moe import ExpertsInterface
+
+
+_DTYPES = {"F32": torch.float32, "F16": torch.float16, "BF16": torch.bfloat16}
+
+
+def _qwen3_5_moe_text_config(directory):
+    return Qwen3_5MoeConfig.from_pretrained(directory, local_files_only=True).text_config
+
+
+# model_type -> (text config loader, causal LM class, experts class, rotary class,
+#                checkpoint prefix of the text model, checkpoint prefixes that are deliberately not loaded)
+_ARCHITECTURES = {
+    "qwen3_moe": (
+        lambda directory: Qwen3MoeConfig.from_pretrained(directory, local_files_only=True),
+        Qwen3MoeForCausalLM,
+        Qwen3MoeExperts,
+        Qwen3MoeRotaryEmbedding,
+        "model.",
+        (),
+    ),
+    # Multimodal Qwen3.5/3.6 MoE checkpoint: load only the text model; skip the vision tower and the MTP head.
+    "qwen3_5_moe": (
+        _qwen3_5_moe_text_config,
+        Qwen3_5MoeForCausalLM,
+        Qwen3_5MoeExperts,
+        Qwen3_5MoeTextRotaryEmbedding,
+        "model.language_model.",
+        ("model.visual.", "mtp."),
+    ),
+    "qwen3_5_moe_text": (
+        lambda directory: Qwen3_5MoeTextConfig.from_pretrained(directory, local_files_only=True),
+        Qwen3_5MoeForCausalLM,
+        Qwen3_5MoeExperts,
+        Qwen3_5MoeTextRotaryEmbedding,
+        "model.",
+        ("model.visual.", "mtp."),
+    ),
+}
+
+
+class SafetensorsReader:
+    """Index validated safetensors headers, then read whole tensors or contiguous expert slices.
+
+    File handles are scoped to individual reads. No whole-file mapping survives indexing and no full
+    packed expert tensor is loaded. Both sharded and single-file local checkpoints are supported.
+    """
+
+    def __init__(self, directory):
+        directory = Path(directory)
+        index = directory / "model.safetensors.index.json"
+        if index.exists():
+            weight_map = json.loads(index.read_text())["weight_map"]
+            filenames = sorted(set(weight_map.values()))
+        else:
+            weight_map = None
+            filenames = ["model.safetensors"]
+        self.tensors = {}
+        self.read_bytes = 0
+        self.read_calls = 0
+        for filename in filenames:
+            path = (directory / filename).resolve()
+            if not path.is_file():
+                raise FileNotFoundError(f"Missing checkpoint shard: {path}")
+            # Delegate safetensors format validation (offsets, sizes, overlaps) to safetensors.
+            with safe_open(path, framework="pt", device="cpu") as handle:
+                keys = set(handle.keys())
+            with path.open("rb") as handle:
+                header_size = int.from_bytes(handle.read(8), "little")
+                header = json.loads(handle.read(header_size))
+            for name in keys:
+                info = header[name]
+                if name in self.tensors:
+                    raise ValueError(f"Duplicate checkpoint tensor: {name}")
+                if info["dtype"] not in _DTYPES:
+                    raise ValueError(f"Only unquantized F32/F16/BF16 checkpoints are supported: {name}")
+                self.tensors[name] = (path, 8 + header_size + info["data_offsets"][0], info)
+                if weight_map is not None and weight_map.get(name) != filename:
+                    raise ValueError(f"Checkpoint index disagrees with shard for {name}")
+        if weight_map is not None and set(weight_map) != set(self.tensors):
+            raise ValueError("Checkpoint index contains missing tensors")
+
+    def shape(self, name):
+        return tuple(self.tensors[name][2]["shape"])
+
+    def read(self, name, expert=None):
+        path, offset, info = self.tensors[name]
+        shape = tuple(info["shape"])
+        dtype = _DTYPES[info["dtype"]]
+        item_size = torch.empty((), dtype=dtype).element_size()
+        if expert is not None:
+            if len(shape) != 3 or not 0 <= expert < shape[0]:
+                raise ValueError(f"Invalid expert slice {expert} for {name}: {shape}")
+            shape = shape[1:]
+            offset += expert * math.prod(shape) * item_size
+        size = math.prod(shape) * item_size
+        data = bytearray(size)
+        with path.open("rb", buffering=0) as handle:
+            handle.seek(offset)
+            view = memoryview(data)
+            done = 0
+            while done < size:
+                count = handle.readinto(view[done:])
+                if not count:
+                    raise OSError(f"Short checkpoint read: {path}, tensor {name}")
+                done += count
+        self.read_bytes += size
+        self.read_calls += 1
+        return torch.frombuffer(data, dtype=dtype).reshape(shape)
+
+
+# GGUF metadata value types -> struct formats (8 = string and 9 = array are handled separately).
+_GGUF_SCALARS = {0: "<B", 1: "<b", 2: "<H", 3: "<h", 4: "<I", 5: "<i", 6: "<f", 7: "<?", 10: "<Q", 11: "<q", 12: "<d"}
+# ggml tensor types this reader understands -> (elements per block, bytes per block).
+_GGML_F32, _GGML_F16, _GGML_Q8_0, _GGML_BF16 = 0, 1, 8, 30
+_GGML_BLOCKS = {_GGML_F32: (1, 4), _GGML_F16: (1, 2), _GGML_Q8_0: (32, 34), _GGML_BF16: (1, 2)}
+_GGUF_PROJECTIONS = {"gate": "ffn_gate_exps", "up": "ffn_up_exps", "down": "ffn_down_exps"}
+
+
+def _read_gguf_index(handle):
+    """Parse a GGUF (v2/v3) header: {tensor name: (ggml dims, ggml type, absolute offset)}. Reads no tensor data."""
+
+    def read(fmt):
+        return struct.unpack(fmt, handle.read(struct.calcsize(fmt)))[0]
+
+    def string():
+        return handle.read(read("<Q")).decode("utf-8")
+
+    def value(kind):
+        if kind == 8:
+            return string()
+        if kind == 9:
+            item, count = read("<I"), read("<Q")
+            return [value(item) for _ in range(count)]
+        if kind not in _GGUF_SCALARS:
+            raise ValueError(f"Unknown GGUF metadata type {kind}")
+        return read(_GGUF_SCALARS[kind])
+
+    if handle.read(4) != b"GGUF":
+        raise ValueError("Not a GGUF file")
+    version, n_tensors, n_metadata = read("<I"), read("<Q"), read("<Q")
+    if version not in (2, 3):
+        raise ValueError(f"Unsupported GGUF version {version}")
+    metadata = {}
+    for _ in range(n_metadata):
+        key = string()
+        metadata[key] = value(read("<I"))
+    infos = []
+    for _ in range(n_tensors):
+        name = string()
+        dims = [read("<Q") for _ in range(read("<I"))]
+        infos.append((name, dims, read("<I"), read("<Q")))
+    alignment = metadata.get("general.alignment", 32)
+    start = handle.tell()
+    start += -start % alignment
+    return {name: (dims, kind, start + offset) for name, dims, kind, offset in infos}
+
+
+class GGUFExpertReader:
+    """Read single experts of llama.cpp ``blk.N.ffn_{gate,up,down}_exps`` tensors, as raw bytes.
+
+    ggml stores such a tensor with dims ``[columns, rows, experts]`` (innermost first), so one expert is one contiguous
+    ``rows x columns`` matrix in the PyTorch ``(out_features, in_features)`` orientation. Q8_0 rows are blocks of one
+    float16 scale and 32 int8 values; they stay quantized until :func:`dequantize_gguf` runs on the execution device.
+    """
+
+    def __init__(self, path):
+        self.path = Path(path).resolve()
+        with self.path.open("rb") as handle:
+            self.tensors = _read_gguf_index(handle)
+        self.read_bytes = 0
+        self.read_calls = 0
+
+    def layout(self, layer, projection):
+        name = f"blk.{layer}.{_GGUF_PROJECTIONS[projection]}.weight"
+        if name not in self.tensors:
+            raise ValueError(f"Missing GGUF expert tensor {name}")
+        dims, kind, offset = self.tensors[name]
+        if kind not in _GGML_BLOCKS or len(dims) != 3:
+            raise ValueError(f"Unsupported GGUF expert tensor {name}: ggml type {kind}, dims {dims}")
+        columns, rows, experts = dims
+        block_elements, block_bytes = _GGML_BLOCKS[kind]
+        if columns % block_elements:
+            raise ValueError(f"GGUF row of {name} is not a whole number of blocks")
+        expert_bytes = rows * columns // block_elements * block_bytes
+        return kind, rows, columns, experts, offset, expert_bytes
+
+    def read(self, layer, projection, expert):
+        kind, rows, columns, experts, offset, size = self.layout(layer, projection)
+        if not 0 <= expert < experts:
+            raise ValueError(f"Invalid expert {expert} for layer {layer}")
+        data = bytearray(size)
+        with self.path.open("rb", buffering=0) as handle:
+            handle.seek(offset + expert * size)
+            view = memoryview(data)
+            done = 0
+            while done < size:
+                count = handle.readinto(view[done:])
+                if not count:
+                    raise OSError(f"Short GGUF read: {self.path}, layer {layer} {projection}")
+                done += count
+        self.read_bytes += size
+        self.read_calls += 1
+        return torch.frombuffer(data, dtype=torch.uint8)
+
+
+def dequantize_gguf(raw, kind, rows, columns, dtype):
+    """Raw bytes of one ggml matrix (on any device) -> a ``(rows, columns)`` tensor of ``dtype`` on that device."""
+    if kind == _GGML_Q8_0:
+        blocks = raw.view(rows, columns // 32, 34)
+        scales = blocks[..., :2].contiguous().view(torch.float16).float()
+        values = blocks[..., 2:].contiguous().view(torch.int8).float()
+        return (values * scales).to(dtype).reshape(rows, columns)
+    source = {_GGML_F32: torch.float32, _GGML_F16: torch.float16, _GGML_BF16: torch.bfloat16}[kind]
+    return raw.view(source).reshape(rows, columns).to(dtype)
+
+
+class ExpertStore:
+    """One global LRU across layers, budgeted in bytes of what it keeps on the execution device: the execution dtype,
+    or the GGUF's own bytes (e.g. Q8_0) when the experts come from a GGUF, dequantized on each use.
+
+    A miss evicts before loading. One active expert plus conversion/staging memory may exceed the cache
+    budget. Eviction never overwrites a tensor used by queued work; PyTorch owns tensor lifetimes.
+    The store is synchronous and intended for one inference request at a time.
+    """
+
+    def __init__(self, reader, cache_bytes, device, dtype, gguf=None):
+        if cache_bytes < 0:
+            raise ValueError("cache_bytes must be nonnegative")
+        self.reader = reader
+        self.gguf = gguf
+        self.cache_bytes = cache_bytes
+        self.device = torch.device(device)
+        self.dtype = dtype
+        self.cache = OrderedDict()
+        self.resident_bytes = 0
+        self.peak_cache_bytes = 0
+        self.hits = self.misses = self.evictions = 0
+        self.layouts = {}
+
+    def register(self, prefix, module):
+        shapes = {
+            "gate_up_proj": (module.num_experts, 2 * module.intermediate_dim, module.hidden_dim),
+            "down_proj": (module.num_experts, module.hidden_dim, module.intermediate_dim),
+        }
+        if f"{prefix}.gate_up_proj" in self.reader.tensors:
+            names = {f"{prefix}.{suffix}": shape for suffix, shape in shapes.items()}
+            packed = True
+        else:
+            names = {}
+            for expert in range(module.num_experts):
+                for projection in ("gate_proj", "up_proj", "down_proj"):
+                    shape = (module.intermediate_dim, module.hidden_dim)
+                    if projection == "down_proj":
+                        shape = shape[::-1]
+                    names[f"{prefix}.{expert}.{projection}.weight"] = shape
+            packed = False
+        for name, shape in names.items():
+            if name not in self.reader.tensors or self.reader.shape(name) != shape:
+                raise ValueError(f"Missing or incompatible expert tensor {name}; expected {shape}")
+        self.layouts[prefix] = (packed, 3 * module.intermediate_dim * module.hidden_dim)
+        if self.gguf is not None:
+            match = re.search(r"\.layers\.(\d+)\.", f".{prefix}.")
+            if match is None:
+                raise ValueError(f"Cannot find the layer index of {prefix}")
+            layer = int(match.group(1))
+            expected = {
+                "gate": (module.intermediate_dim, module.hidden_dim),
+                "up": (module.intermediate_dim, module.hidden_dim),
+                "down": (module.hidden_dim, module.intermediate_dim),
+            }
+            layouts = {}
+            for projection, shape in expected.items():
+                kind, rows, columns, experts, _, size = self.gguf.layout(layer, projection)
+                if (rows, columns) != shape or experts != module.num_experts:
+                    raise ValueError(
+                        f"GGUF layer {layer} {projection} is {experts}x{rows}x{columns}; expected {shape}"
+                    )
+                layouts[projection] = (kind, rows, columns, size)
+            # The safetensors expert banks are deliberately not read: they count as consumed.
+            self.layouts[prefix] = ("gguf", layer, layouts)
+        return set(names)
+
+    def get(self, prefix, expert):
+        key = (prefix, expert)
+        if key in self.cache:
+            self.hits += 1
+            self.cache.move_to_end(key)
+            return self._materialize(prefix, self.cache[key])
+        self.misses += 1
+        layout = self.layouts[prefix]
+        if layout[0] == "gguf":
+            _, layer, layouts = layout
+            size = sum(entry[3] for entry in layouts.values())
+        else:
+            packed, elements = layout
+            size = elements * torch.empty((), dtype=self.dtype).element_size()
+        while self.cache and self.resident_bytes + size > self.cache_bytes:
+            _, (_, _, old_size) = self.cache.popitem(last=False)
+            self.resident_bytes -= old_size
+            self.evictions += 1
+        if layout[0] == "gguf":
+            # Keep the GGUF bytes on the device; dequantize each time the expert runs.
+            gate_up = tuple(self.gguf.read(layer, p, expert).to(self.device) for p in ("gate", "up"))
+            down = self.gguf.read(layer, "down", expert).to(self.device)
+        elif packed:
+            gate_up = self.reader.read(f"{prefix}.gate_up_proj", expert).to(self.device, self.dtype)
+            down = self.reader.read(f"{prefix}.down_proj", expert).to(self.device, self.dtype)
+        else:
+            gate = self.reader.read(f"{prefix}.{expert}.gate_proj.weight").to(self.device, self.dtype)
+            up = self.reader.read(f"{prefix}.{expert}.up_proj.weight").to(self.device, self.dtype)
+            gate_up = torch.cat((gate, up))
+            del gate, up
+            down = self.reader.read(f"{prefix}.{expert}.down_proj.weight").to(self.device, self.dtype)
+        result = (gate_up, down, size)
+        if size <= self.cache_bytes:
+            self.cache[key] = result
+            self.resident_bytes += size
+            self.peak_cache_bytes = max(self.peak_cache_bytes, self.resident_bytes)
+        return self._materialize(prefix, result)
+
+    def _materialize(self, prefix, entry):
+        gate_up, down, size = entry
+        layout = self.layouts[prefix]
+        if layout[0] != "gguf":
+            return entry
+        layouts = layout[2]
+        gate_up = torch.cat(
+            [dequantize_gguf(raw, *layouts[p][:3], self.dtype) for raw, p in zip(gate_up, ("gate", "up"))]
+        )
+        return gate_up, dequantize_gguf(down, *layouts["down"][:3], self.dtype), size
+
+    def stats(self):
+        return {
+            "hits": self.hits,
+            "misses": self.misses,
+            "evictions": self.evictions,
+            "resident_bytes": self.resident_bytes,
+            "peak_cache_bytes": self.peak_cache_bytes,
+            "read_bytes": self.reader.read_bytes + (self.gguf.read_bytes if self.gguf else 0),
+            "read_calls": self.reader.read_calls + (self.gguf.read_calls if self.gguf else 0),
+        }
+
+
+def streamed_experts_forward(module, hidden_states, top_k_index, top_k_weights):
+    if module.training or torch.is_grad_enabled():
+        raise RuntimeError("SSD expert streaming requires eval() and torch.no_grad() / inference_mode()")
+    store = module.ssd_store
+    if hidden_states.device != store.device or hidden_states.dtype != store.dtype:
+        raise ValueError(
+            "Moving/casting a streamed model after loading is unsupported; reload on the target device/dtype"
+        )
+    result = torch.zeros_like(hidden_states)
+    # Routing IDs are small; copy them once, rather than synchronizing for every expert.
+    routing = top_k_index.cpu()
+    for expert in torch.unique(routing).tolist():
+        if not 0 <= expert < module.num_experts:
+            raise ValueError("Expert parallelism and sentinel expert IDs are unsupported")
+        token, slot = torch.where(routing == expert)
+        token, slot = token.to(hidden_states.device), slot.to(hidden_states.device)
+        gate_up, down, _ = store.get(module.ssd_prefix, expert)
+        # Bound the temporary activations during prefill, even when one expert serves many tokens.
+        for start in range(0, token.numel(), module.ssd_token_chunk_size):
+            indices = token[start : start + module.ssd_token_chunk_size]
+            slots = slot[start : start + module.ssd_token_chunk_size]
+            gate, up = torch.nn.functional.linear(hidden_states[indices], gate_up).chunk(2, dim=-1)
+            output = torch.nn.functional.linear(module.act_fn(gate) * up, down)
+            output = output * top_k_weights[indices, slots, None]
+            result.index_add_(0, indices, output.to(result.dtype))
+        del gate_up, down
+    return result
+
+
+def load_moe_from_ssd(
+    directory, *, device="cpu", dtype=torch.float32, cache_bytes=0, token_chunk_size=256, experts_gguf=None
+):
+    """Load a local, unquantized Qwen MoE checkpoint without allocating resident expert banks.
+
+    With ``experts_gguf`` (a llama.cpp GGUF of the same model), the experts are streamed from that file instead, in its
+    own quantization (Q8_0 is dequantized on the device at each use); ``cache_bytes`` then counts the GGUF's bytes.
+
+    Supports ``qwen3_moe`` (original per-expert or packed experts) and the text model of ``qwen3_5_moe``.
+    Does not require Accelerate, checkpoint conversion, kernels, or a second copy of the weights.
+    The returned model is inference-only: do not train, move/cast, save_pretrained, compile, or change
+    its experts implementation. Reload the original checkpoint to obtain an ordinary model.
+    """
+    if dtype not in _DTYPES.values() or token_chunk_size <= 0:
+        raise ValueError("Use a floating dtype (float32/float16/bfloat16) and positive token_chunk_size")
+    raw_config = json.loads((Path(directory) / "config.json").read_text())
+    model_type = raw_config.get("model_type")
+    if model_type not in _ARCHITECTURES or raw_config.get("quantization_config"):
+        raise ValueError(f"This prototype supports only unquantized {sorted(_ARCHITECTURES)} checkpoints")
+    load_config, model_class, experts_class, rotary_class, prefix, skipped = _ARCHITECTURES[model_type]
+    config = load_config(directory)
+    config._attn_implementation = "eager"
+    config._experts_implementation = "ssd_streaming"
+    ExpertsInterface.register("ssd_streaming", streamed_experts_forward)
+    # Resolve cuda -> cuda:0 and analogous device aliases for forward validation.
+    device = torch.empty(0, device=device).device
+    reader = SafetensorsReader(directory)
+    store = ExpertStore(reader, cache_bytes, device, dtype, GGUFExpertReader(experts_gguf) if experts_gguf else None)
+
+    def checkpoint_name(name):
+        return prefix + name.removeprefix("model.") if name.startswith("model.") else name
+
+    with torch.device("meta"):
+        model = model_class(config)
+    consumed = {name for name in reader.tensors if name.startswith(skipped)} if skipped else set()
+    for name, module in model.named_modules():
+        if isinstance(module, experts_class):
+            consumed.update(store.register(checkpoint_name(name), module))
+            # Keep no meta Parameters that an offload hook could materialize as whole banks.
+            module.register_parameter("gate_up_proj", None)
+            module.register_parameter("down_proj", None)
+            module.ssd_store = store
+            module.ssd_prefix = checkpoint_name(name)
+            module.ssd_token_chunk_size = token_chunk_size
+    # Load dense weights individually; peak host staging is one dense tensor, not one shard.
+    for name, parameter in list(model.named_parameters()):
+        source = checkpoint_name(name)
+        if config.tie_word_embeddings and name == "lm_head.weight" and name not in reader.tensors:
+            source = checkpoint_name("model.embed_tokens.weight")
+        if source not in reader.tensors or reader.shape(source) != tuple(parameter.shape):
+            raise ValueError(f"Missing or incompatible dense tensor: {source}")
+        value = reader.read(source).to(device=device, dtype=dtype)
+        parent, _, attr = name.rpartition(".")
+        model.get_submodule(parent).register_parameter(attr, torch.nn.Parameter(value, requires_grad=False))
+        consumed.add(source)
+    unexpected = set(reader.tensors) - consumed
+    if unexpected:
+        raise ValueError(f"Unsupported checkpoint tensors: {sorted(unexpected)[:10]}")
+    model.tie_weights()
+    # RoPE has nonpersistent buffers, so checkpoint loading cannot materialize them.
+    model.model.rotary_emb = rotary_class(config).to(device)
+    meta = [n for n, t in list(model.named_parameters()) + list(model.named_buffers()) if t.is_meta]
+    if meta:
+        raise RuntimeError(f"Unmaterialized model state after streaming load: {meta[:10]}")
+    model.eval()
+    model.ssd_store = store
+    # Exclude dense startup I/O from expert runtime counters.
+    reader.read_bytes = reader.read_calls = 0
+    if store.gguf is not None:
+        store.gguf.read_bytes = store.gguf.read_calls = 0
+    return model
+
+
+# Backward-compatible name used by the first version of this prototype.
+load_qwen3_moe_from_ssd = load_moe_from_ssd
