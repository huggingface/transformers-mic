+def quantize_q8_0(weight):
+    """A (rows, columns) float tensor -> (raw Q8_0 bytes, the weight those bytes dequantize to)."""
+    blocks = weight.float().reshape(weight.shape[0], -1, 32)
+    scales = (blocks.abs().amax(-1, keepdim=True) / 127).to(torch.float16)
+    values = torch.where(scales == 0, 0, torch.round(blocks / scales.float())).clamp(-127, 127).to(torch.int8)
+    raw = torch.cat((scales.view(torch.uint8), values.view(torch.uint8)), dim=-1)
+    return raw.reshape(-1), (values.float() * scales.float()).reshape(weight.shape)
+
+
+def write_gguf(path, tensors):
+    """Minimal GGUF v3 with no metadata: tensors maps a name to (ggml dims, ggml type, raw bytes)."""
+    import struct
+
+    header = bytearray(b"GGUF" + struct.pack("<IQQ", 3, len(tensors), 0))
+    offset = 0
+    for name, (dims, kind, raw) in tensors.items():
+        encoded = name.encode()
+        header += struct.pack("<Q", len(encoded)) + encoded + struct.pack("<I", len(dims))
+        header += struct.pack(f"<{len(dims)}Q", *dims) + struct.pack("<IQ", kind, offset)
+        offset += -(-raw.numel() // 32) * 32
+    header += bytes(-len(header) % 32)
+    with open(path, "wb") as handle:
+        handle.write(header)
+        for _, _, raw in tensors.values():
+            handle.write(raw.numpy().tobytes() + bytes(-raw.numel() % 32))
+
+
