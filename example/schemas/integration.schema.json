{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "MIC manifest (integration.json)",
 "type": "object",
 "required": [
  "mic",
  "name",
  "usage",
  "checkpoints",
  "fixtures",
  "integrations",
  "outputs"
 ],
 "properties": {
  "mic": {
   "enum": [
    "0.2",
    "0.3"
   ]
  },
  "name": {
   "type": "string"
  },
  "usage": {
   "type": "string"
  },
  "architecture": {
   "type": "string"
  },
  "checkpoints": {
   "type": "object",
   "minProperties": 1,
   "propertyNames": {
    "type": "string",
    "pattern": "^[\\w.-]+/[\\w.-]+$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "fixture"
    ],
    "properties": {
     "fixture": {
      "type": "string",
      "pattern": "^[\\w.-]+/[\\w.-]+$"
     }
    }
   }
  },
  "fixtures": {
   "type": "object",
   "propertyNames": {
    "type": "string",
    "pattern": "^[\\w.-]+/[\\w.-]+$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "built_from",
     "covers"
    ],
    "properties": {
     "built_from": {
      "type": "string",
      "pattern": "^[\\w.-]+/[\\w.-]+$"
     },
     "covers": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[\\w.-]+/[\\w.-]+$"
      },
      "minItems": 1
     },
     "why_separate": {
      "type": "string"
     },
     "build": {
      "type": "object",
      "description": "recipe for build_fixtures.py; absent for fixtures built by an earlier tool",
      "required": [
       "seed"
      ],
      "additionalProperties": false,
      "properties": {
       "seed": {
        "type": "integer"
       },
       "model_class": {
        "type": "string"
       },
       "gate_tolerance": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "strictest atol the fixture must hold on any platform; defaults to the manifest's"
       },
       "max_steps": {
        "type": "integer",
        "minimum": 1
       },
       "accept_insensitive": {
        "type": "object",
        "description": "perturbations (input:perturbation) the fixture may ignore, with the reviewed reason; still measured and reported",
        "additionalProperties": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    }
   }
  },
  "integrations": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "object",
    "required": [
     "entry_point",
     "format",
     "targets",
     "variants",
     "training"
    ],
    "properties": {
     "entry_point": {
      "type": "string"
     },
     "format": {
      "enum": [
       "runnable-markdown",
       "script"
      ]
     },
     "requires": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "targets": {
      "type": "array",
      "items": {
       "enum": [
        "fixtures",
        "checkpoints"
       ]
      },
      "minItems": 1
     },
     "artifacts": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": [
        "repo"
       ],
       "properties": {
        "repo": {
         "type": "string",
         "pattern": "^[\\w.-]+/[\\w.-]+$"
        },
        "file": {
         "type": "string"
        }
       }
      }
     },
     "unsupported": {
      "type": "object",
      "additionalProperties": {
       "type": "string",
       "minLength": 1
      }
     },
     "variants": {
      "type": "object",
      "required": [
       "default"
      ],
      "additionalProperties": {
       "type": "object"
      }
     },
     "training": {
      "type": "boolean"
     },
     "resources": {
      "type": "object"
     }
    }
   }
  },
  "outputs": {
   "type": "object",
   "required": [
    "runtime"
   ],
   "additionalProperties": {
    "type": "object",
    "required": [
     "compare"
    ],
    "additionalProperties": false,
    "properties": {
     "compare": {
      "enum": [
       "exact",
       "allclose",
       "all_true",
       "true"
      ]
     },
     "atol": {
      "type": "number",
      "minimum": 0
     },
     "rtol": {
      "type": "number",
      "minimum": 0
     }
    },
    "if": {
     "properties": {
      "compare": {
       "const": "allclose"
      }
     }
    },
    "then": {
     "required": [
      "atol",
      "rtol"
     ]
    }
   }
  }
 }
}
